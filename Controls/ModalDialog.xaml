<UserControl x:Class="HITAPEX.Controls.ModalDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             x:Name="DialogRoot"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="Margin" Value="0,4,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" CornerRadius="1.5">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C60E0E" CornerRadius="1.5" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#991B1B1B" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid Width="620" Height="301" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="DialogContent_MouseLeftButtonDown">
            <Path Data="M620 0H15L0 15V301H605L620 286V0Z" 
                  Fill="#4A4A4A" 
                  Stretch="Fill"/>
            
            <svgc:SvgViewbox Source="/Assets/Group126548508.svg" 
                              Stretch="Fill"/>
            
            <Path Data="M599.5 0.5V271.793L590.793 280.5H0.5V9.20703L9.20703 0.5H599.5Z" 
                  Stroke="#EEEEEE" 
                  StrokeThickness="1"
                  Stretch="Fill"
                  Width="600"
                  Height="281"/>
            
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <svgc:SvgViewbox x:Name="TitleIcon"
                                     Source="/Assets/Group4.svg" 
                                     Width="20" 
                                     Height="20"
                                     Margin="0,0,11,0"
                                     Visibility="Collapsed"/>
                    <TextBlock x:Name="TitleText" 
                               FontSize="30" 
                               FontWeight="Bold" 
                               Foreground="#EEEEEE" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <ContentPresenter x:Name="DialogContentPresenter" 
                                  Grid.Row="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"   />
                
                <Grid x:Name="ButtonPanel" 
                      Grid.Row="2" 
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
