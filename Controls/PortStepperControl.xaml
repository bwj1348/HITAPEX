<UserControl x:Class="HITAPEX.Controls.PortStepperControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xml:space="preserve">
    <UserControl.Resources>
        <!-- +/- 两个按钮的通用透明模板，用 Path 绘制符号 -->
        <Style x:Key="StepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Height="26">
        <Path Data="M5 11V31H231L237 25V5H11L5 11Z" Fill="#EEEEEE" Opacity="0.2" Stretch="Fill">
            <Path.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5" ShadowDepth="2"/>
            </Path.Effect>
        </Path>

        <!-- 左侧：可直接编辑的端口号输入框 -->
        <TextBox x:Name="PortTextBox"
                 Text="{Binding Port, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#EEEEEE"
                 FontSize="16"
                 FontWeight="SemiBold"
                 FontFamily="{StaticResource OrbitronFont}"
                 CaretBrush="#EEEEEE"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Left"
                 Margin="10,0,54,0"
                 Padding="0"/>

        <!-- 右侧：减号、加号按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Style="{StaticResource StepButtonStyle}" Click="MinusButton_Click" Margin="0,0,10,0">
                <Path Data="M4,6 L12,6" Stroke="#EEEEEE" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill"
                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource StepButtonStyle}" Click="PlusButton_Click">
                <Path VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill">
                    <Path.Data>
                        <GeometryGroup>
                            <PathGeometry Figures="M8,2 L8,10"/>
                            <PathGeometry Figures="M4,6 L12,6"/>
                        </GeometryGroup>
                    </Path.Data>
                    <Path.Stroke>
                        <SolidColorBrush Color="#EEEEEE"/>
                    </Path.Stroke>
                    <Path.StrokeThickness>1.5</Path.StrokeThickness>
                    <Path.StrokeStartLineCap>Round</Path.StrokeStartLineCap>
                    <Path.StrokeEndLineCap>Round</Path.StrokeEndLineCap>
                </Path>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>