<Window x:Class="HITAPEX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HITAPEX.ViewModels"
        xmlns:ctrl="clr-namespace:HITAPEX.Controls"
        xmlns:views="clr-namespace:HITAPEX.Views"
        xmlns:lex="clr-namespace:HITAPEX.Helpers"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="HITAPEX"
        Height="950" Width="1500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{lex:Font}"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 顶级页面切换的统一淡入动效（与设备子页切换一致的视觉语言） -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LeftBar" Grid.Column="0" Background="Transparent" CornerRadius="0"/>
                            <Border x:Name="GradientBg" Grid.Column="1" Background="Transparent" CornerRadius="0" Padding="10,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <svgc:SvgViewbox x:Name="Icon" Source="{Binding IconPath}"
                                                     Width="25" Height="25" Opacity="0.8"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Label" Grid.Column="1"
                                               Text="{Binding Label}" FontSize="18"
                                               Foreground="#EEEEEE" FontWeight="Regular" Opacity="0.8"
                                               VerticalAlignment="Center" Margin="{lex:NavSpacing}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LeftBar" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#C60E0E"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="GradientBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                            <GradientStop Color="#99120000" Offset="0"/>
                                            <GradientStop Color="#CC320000" Offset="0.4"/>
                                            <GradientStop Color="#FF530000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                <Setter TargetName="Label" Property="Opacity" Value="1"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8892A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.Background>
            <SolidColorBrush Color="#0B0B0B"/>
        </Grid.Background>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.75,0.6" EndPoint="1,1">
                    <GradientStop Color="#0B0B0B" Offset="0"/>
                    <GradientStop Color="#353535" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <svgc:SvgViewbox Source="/Assets/Group126548063.svg"
                         Stretch="Fill"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#161616"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Width="1500" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleVersionText"
                               FontFamily="{StaticResource OrbitronFont}"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="ExtraBold"
                               VerticalAlignment="Center"
                               Margin="23,0,0,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                            <Path Data="M1 1H15" Stroke="#EEEEEE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="2" Stretch="Fill"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                            <Path Data="M9.65857 0.23013C9.96541 -0.0766405 10.4631 -0.0766869 10.7699 0.23013C11.0765 0.536966 11.0766 1.03469 10.7699 1.34146L6.61072 5.49966L10.7699 9.65884C11.0764 9.96571 11.0766 10.4634 10.7699 10.7702C10.4631 11.0766 9.96533 11.0766 9.65857 10.7702L5.49939 6.61099L1.34118 10.7702C1.03439 11.0766 0.53659 11.0767 0.229856 10.7702C-0.0768598 10.4635 -0.07661 9.96571 0.229856 9.65884L4.38806 5.49966L0.229856 1.34146C-0.076883 1.03472 -0.0766796 0.536996 0.229856 0.23013C0.536696 -0.0767101 1.03434 -0.0767101 1.34118 0.23013L5.49939 4.38833L9.65857 0.23013Z" Fill="#EEEEEE" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="158"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#80161616" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,72,0,0">
                            <!-- <Border Margin="22,0,12,30" Width="22" Height="18" HorizontalAlignment="Left">
                                <Grid>
                                    <Rectangle Width="22" Height="2" Fill="#EEEEEE" RadiusX="1" RadiusY="1" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <Rectangle Width="15" Height="2" Fill="#EEEEEE" RadiusX="1" RadiusY="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Rectangle Width="9" Height="2" Fill="#EEEEEE" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border> -->
                            <ItemsControl ItemsSource="{Binding NavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                        <RadioButton Style="{StaticResource NavButtonStyle}"
                                                     GroupName="NavItems"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Checked="NavigationItem_Checked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,37" HorizontalAlignment="Center">
                            <Grid Width="158" Height="68">
                                <!-- 背景填充（线性渐变）+ 边框（#EEEEEE） -->
                                <Path Data="M0 9V68H149L158 59V0H9L0 9Z"
                                      Stretch="Fill"
                                      Stroke="#33EEEEEE" StrokeThickness="1">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,33.9623" EndPoint="286.27,33.9623" MappingMode="Absolute">
                                            <GradientStop Color="#33607079" Offset="0"/>
                                            <GradientStop Color="#333F4A50" Offset="0.4375"/>
                                            <GradientStop Color="#33282D30" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <Grid Margin="11,16,11,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="36" Height="36">
                                        <!-- 左侧图标区：未登录显示默认图标，登录后显示用户头像 -->
                                        <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid.Clip>
                                                <PathGeometry Figures="M0,0 L30,0 L30,22 L22,30 L0,30 Z"/>
                                            </Grid.Clip>
                                            <!-- 默认图标（未登录）：#EEEEEE 背景 + 灰色人形 -->
                                            <Grid x:Name="UserIconDefault" Background="#EEEEEE" Visibility="Visible">
                                                <Viewbox Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Stretch="Uniform">
                                                    <Canvas Width="16" Height="17">
                                                        <Path Fill="#A1A1A1" Stroke="#A1A1A1"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                            <Path.Data>
                                                                <GeometryGroup>
                                                                    <PathGeometry Figures="M7.6543 0.5C9.86345 0.5 11.6543 2.29085 11.6543 4.5C11.6543 6.70918 9.86347 8.5 7.6543 8.5C5.44515 8.49996 3.6543 6.70915 3.6543 4.5C3.65433 2.29088 5.44517 0.500037 7.6543 0.5Z"/>
                                                                    <PathGeometry Figures="M7.65527 10.5C9.24174 10.5 10.7876 11.0035 12.0693 11.9385C13.351 12.8734 14.3026 14.1915 14.7871 15.7021C14.8359 15.8542 14.8089 16.0204 14.7148 16.1494C14.6207 16.2784 14.4703 16.3555 14.3105 16.3555H1C0.840285 16.3555 0.689829 16.2784 0.595703 16.1494C0.501788 16.0204 0.47471 15.8541 0.523438 15.7021C1.00791 14.1914 1.96048 12.8734 3.24219 11.9385C4.52376 11.0037 6.06903 10.5001 7.65527 10.5Z"/>
                                                                </GeometryGroup>
                                                            </Path.Data>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                            <!-- 用户头像（登录后） -->
                                            <Image x:Name="UserAvatarImage" Source="/Assets/UserAvatar.png" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>

                                        <!-- 在线状态点 -->
                                        <Grid Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                            <Grid.LayoutTransform>
                                                <RotateTransform Angle="45"/>
                                            </Grid.LayoutTransform>
                                            <Rectangle Stroke="#22C55E" StrokeThickness="0.28" Width="8" Height="8"/>
                                            <Rectangle Fill="#23C860" Margin="1.1"/>
                                        </Grid>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                        <TextBlock x:Name="UserRoleText" Text="{lex:Loc Window.Guest}" FontSize="14" Foreground="#99EEEEEE" FontWeight="Bold"/>
                                        <TextBlock x:Name="UserDisplayNameText" Text="{lex:Loc Window.GuestMode}" FontSize="14" Foreground="#EEEEEE" FontWeight="Bold" Margin="0,2,0,0"
                                                   FontFamily="{StaticResource OrbitronFont}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Width="1" Background="#383838" HorizontalAlignment="Right"/>

                <Border Grid.Column="1" Background="Transparent">
                    <ContentControl x:Name="MainContentHost" Content="{Binding CurrentView}" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
        
        <ctrl:ModalDialog x:Name="GlobalDialog" Panel.ZIndex="1000"/>
        <views:LoginPopup x:Name="LoginPopupDialog" Panel.ZIndex="1001" Visibility="Collapsed"/>
    </Grid>
</Window>
