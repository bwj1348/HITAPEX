<Window x:Class="HITAPEX.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:HITAPEX.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520" Height="380"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="OrbitronFont">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
    </Window.Resources>

    <Grid>
        <!-- 仅一个简单背景，无 DropShadowEffect -->
        <Border Background="#0B0B0B" CornerRadius="8"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- 品牌名（仅文字，发光由动画在 code-behind 控制） -->
        <TextBlock x:Name="BrandText"
                   Text="{lex:Loc Splash.BrandName}"
                   FontFamily="{StaticResource OrbitronFont}"
                   FontSize="48"
                   FontWeight="ExtraBold"
                   Foreground="#EEEEEE"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4">
            <TextBlock.Effect>
                <DropShadowEffect x:Name="BrandTextGlow"
                                  Color="#C60E0E" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- 副标题 -->
        <TextBlock x:Name="SubtitleText"
                   Text="{lex:Loc Splash.Subtitle}"
                   FontFamily="{StaticResource OrbitronFont}"
                   FontSize="14"
                   Foreground="#80EEEEEE"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,50"/>

        <!-- 加载文字：loading 固定位置，圆点在后追加，预留最大宽度防止 loading 左右偏移 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{lex:Loc Splash.Loading}"
                       FontSize="18"
                       Foreground="#60EEEEEE"
                       FontFamily="{StaticResource OrbitronFont}" Margin="20,0,0,0"/>
            <TextBlock x:Name="LoadingDots"
                       Text=" ."
                       FontSize="18"
                       Foreground="#60EEEEEE"
                       FontFamily="{StaticResource OrbitronFont}"
                       Width="60"
                       TextAlignment="Left"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
