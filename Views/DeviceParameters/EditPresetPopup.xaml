<UserControl x:Class="HITAPEX.Views.DeviceParameters.EditPresetPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <!-- 编辑弹窗按钮样式（确定按钮，红色主题） -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="173"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="BtnPath"
                                  Data="M0 6V32H166L172 26V0H6L0 6Z"
                                  Fill="{StaticResource AccentGradient}" Stretch="Fill"
                                  Width="173" Height="32"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 编辑弹窗按钮样式（取消按钮，灰色主题） -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="173"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="BtnPath"
                                  Data="M0 6V32H166L172 26V0H6L0 6Z"
                                  Fill="#33EEEEEE" Stretch="Fill"
                                  Width="173" Height="32"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字按钮样式（清空全部 / × 按钮） -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99EEEEEE"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字母索引按钮样式 -->
        <Style x:Key="LetterIndexButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="13.7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 游戏选择复选框样式（基于 RadioButtonStyle） -->
        <Style x:Key="SelectCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="22" Height="18" Margin="0,3,5,0" VerticalAlignment="Top">
                                <Path x:Name="CheckOuter"
                                      Data="M20.8093 0.724774L20.6165 1.44828L16.6167 16.4484L16.4233 17.1738H0.942858L1.13574 16.4503L5.13549 1.45016L5.32888 0.724774H20.8093Z"
                                      Stroke="#C60E0E" StrokeThickness="1.5"
                                      Fill="Transparent" Stretch="Fill"/>
                                <Path x:Name="CheckInner"
                                      Data="M15 0H3.5L0 13H11.5167L15 0Z"
                                      Fill="#C60E0E" Stretch="Fill"
                                      Margin="3.5,2.3" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Top"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckInner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 游戏列表滚动条样式 -->
        <Style x:Key="GameListScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10,0,-10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">

                        <Border Background="#EEEEEE" CornerRadius="1.5" Width="3" SnapsToDevicePixels="True" UseLayoutRounding="True"> 

                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C60E0E" CornerRadius="1.5" Width="3" HorizontalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="TitleIconShadow"
                          ShadowDepth="0"
                          BlurRadius="5"
                          Opacity="0.4"/>
    </UserControl.Resources>

    <Grid Panel.ZIndex="1000">
        <!-- 半透明遮罩层 -->
        <Border x:Name="OverlayBackground" Background="#991B1B1B"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                Cursor="Hand"/>

        <!-- 弹窗主体：居中面板 -->
        <Border x:Name="PopupPanel"
                Width="872" Height="639"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Cursor="Arrow">
            <Grid>
                <!-- 窗口边框形状 -->
                <Path Data="M872 0H15L0 15V639H857L872 624V0Z"
                      Fill="#4A4A4A"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- SVG 背景图案 -->
                <svgc:SvgViewbox Source="/Assets/Group1265485081.svg"
                                 Width="872" Height="639" Stretch="Fill"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 装饰性斜角边框 -->
                <Path Data="M831 0V585L819 597H0V12L12 0H831Z"
                      Stroke="#EEEEEE" StrokeThickness="1"
                      Fill="Transparent" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 内容区域 -->
                <Grid Margin="41">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：标题 -->
                    <TextBlock x:Name="TitleText" Grid.Row="0" Text="编 辑"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#EEEEEE"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- 第二行：预设名称输入区域 -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 整行背景 -->
                        <Path Data="M790 0H6L0 6V32H784L790 26V0Z" Grid.ColumnSpan="4" Fill="#EEEEEE" Opacity="0.2" Stretch="Fill" Height="32"/>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="PresetNameTextBox"
                                     Background="Transparent"
                                     Foreground="#EEEEEE"
                                     CaretBrush="#EEEEEE"
                                     FontSize="18"
                                     FontFamily="{StaticResource OrbitronFont}"
                                     BorderThickness="0"
                                     Padding="15,0"
                                     MaxLength="20"
                                     VerticalContentAlignment="Center"
                                     TextChanged="PresetNameTextBox_TextChanged"
                                     PreviewTextInput="PresetNameTextBox_PreviewTextInput"
                                     PreviewKeyDown="PresetNameTextBox_PreviewKeyDown"/>
                            <TextBlock x:Name="WatermarkText"
                                       Text="请输入预设名称"
                                       Foreground="#44EEEEEE"
                                       FontSize="18"
                                       FontFamily="{StaticResource OrbitronFont}"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- 重名提示 -->
                        <TextBlock x:Name="DuplicateNameText" Grid.Column="1"
                                   Text="（与现有预设重名）"
                                   Foreground="#C60E0E"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Visibility="Collapsed"/>

                        <!-- 字数统计 -->
                        <TextBlock x:Name="CharCountText" Grid.Column="2"
                                   Text="0/20"
                                   Foreground="#99EEEEEE"
                                   FontSize="18"
                                   FontFamily="{StaticResource OrbitronFont}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>


                        <!-- 清空名称按钮 -->
                        <Button x:Name="ClearNameButton" Grid.Column="3"
                                Style="{StaticResource TextButtonStyle}"
                                Foreground="#EEEEEE"
                                FontWeight="Bold"
                                Width="17" Height="17"
                                VerticalAlignment="Center" Margin="0,0,15,0"
                                Click="ClearNameButton_Click">
                            <Viewbox Width="17" Height="17">
                                <Grid Width="17" Height="17">
                                    <Path Data="M10.6949 5.80469L5.80261 10.697"
                                          Stroke="#EEEEEE" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M5.80261 5.80469L10.6949 10.697"
                                          Stroke="#EEEEEE" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"
                                          Stroke="#EEEEEE" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- 第四行：游戏标签管理区域 -->
                    <Grid Grid.Row="2" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：所有游戏区域 -->
                        <Grid Grid.Column="0">
                            <Grid>
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 顶部：游戏数量统计 + 全选按钮 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <TextBlock x:Name="GameCountText"
                                                   Text="游戏 (0/0)"
                                                   Foreground="#EEEEEE"
                                                   FontSize="14" FontWeight="Bold"
                                                   FontFamily="{StaticResource OrbitronFont}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Content="全选"
                                                  Style="{StaticResource SelectCheckBoxStyle}"
                                                  FontSize="18"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Click="SelectAllCheckBox_Click"/>
                                    </Grid>

                                    <!-- 游戏列表（含字母索引） -->
                                    <Grid Grid.Row="1" Height="358" VerticalAlignment="Top">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- A-Z 字母索引 -->
                                        <Border Grid.Column="0" Width="15" Margin="0,0,16,0" >
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                                <StackPanel x:Name="LetterIndexPanel"/>
                                            </ScrollViewer>
                                        </Border>

                                        <Grid Grid.Column="1" Width="350" Height="358">
                                            <Grid.Clip>
                                                <PathGeometry Figures="M350 0H6L0 6V358H344L350 352V0Z"/>
                                            </Grid.Clip>

                                            <Path Grid.Column="1" Data="M350 0H6L0 6V358H344L350 352V0Z" Stroke="#33EEEEEE" StrokeThickness="2">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1.8,0.5">
                                                        <GradientStop Color="#33607079" Offset="0"/>
                                                        <GradientStop Color="#333F4A50" Offset="0.44"/>
                                                        <GradientStop Color="#33282D30" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>

                                            <Path Grid.Column="1" Data="M350 0H6L0 6V358H344L350 352V0Z" Fill="Transparent" Stroke="#CC232323" StrokeThickness="15">
                                                <Path.Effect>
                                                    <BlurEffect Radius="45" RenderingBias="Performance"/>
                                                </Path.Effect>
                                                <Path.CacheMode>
                                                    <BitmapCache RenderAtScale="1" SnapsToDevicePixels="True"/>
                                                </Path.CacheMode>
                                            </Path>

                                            <!-- 游戏列表 -->
                                            <ScrollViewer x:Name="AllGamesScrollViewer" Grid.Column="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          ScrollChanged="AllGamesScrollViewer_ScrollChanged"
                                                          Margin="15">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource GameListScrollBarStyle}"/>
                                                </ScrollViewer.Resources>
                                                <StackPanel x:Name="AllGamesPanel"/>
                                            </ScrollViewer>
                                        </Grid>

                                        
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 右侧：已选游戏区域 -->
                        <Grid Grid.Column="2">
                            <Grid>
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 顶部：标题 + 清空全部按钮 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <TextBlock Text="已选游戏"
                                                   Foreground="#EEEEEE"
                                                   FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="ClearAllButton"
                                                Style="{StaticResource TextButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Click="ClearAllSelected_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="17" Height="17" Margin="0,0,5,0">
                                                    <Grid Width="17" Height="17">
                                                        <Path Data="M0.75 4.21094H15.75"
                                                              Stroke="#EEEEEE" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Data="M2.625 4.21094H13.875V14.5956C13.875 14.9016 13.7433 15.1951 13.5089 15.4114C13.2745 15.6278 12.9565 15.7494 12.625 15.7494H3.875C3.54348 15.7494 3.22554 15.6278 2.99112 15.4114C2.7567 15.1951 2.625 14.9016 2.625 14.5956V4.21094Z"
                                                              Stroke="#EEEEEE" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Data="M5.125 4.21154V3.63462C5.125 2.86957 5.45424 2.13585 6.04029 1.59488C6.62634 1.05391 7.4212 0.75 8.25 0.75C9.0788 0.75 9.87366 1.05391 10.4597 1.59488C11.0458 2.13585 11.375 2.86957 11.375 3.63462V4.21154"
                                                              Stroke="#EEEEEE" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Data="M6.375 6.51953V12.8657"
                                                              Stroke="#EEEEEE" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Data="M10.125 6.51953V12.8657"
                                                              Stroke="#EEEEEE" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="清空全部" VerticalAlignment="Center" FontSize="18" Foreground="#EEEEEE" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1" Width="385" Height="358" VerticalAlignment="Top">
                                        <Grid.Clip>
                                            <PathGeometry Figures="M385 0H6L0 6V358H379L385 352L385 0Z"/>
                                        </Grid.Clip>

                                        <Path Grid.Column="1" Data="M385 0H6L0 6V358H379L385 352L385 0Z" Stroke="#33EEEEEE" StrokeThickness="2">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1.8,0.5">
                                                    <GradientStop Color="#33607079" Offset="0"/>
                                                    <GradientStop Color="#333F4A50" Offset="0.44"/>
                                                    <GradientStop Color="#33282D30" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>

                                        <Path Grid.Column="1" Data="M385 0H6L0 6V358H379L385 352L385 0Z" Fill="Transparent" Stroke="#CC232323" StrokeThickness="15">
                                            <Path.Effect>
                                                <BlurEffect Radius="45" RenderingBias="Performance"/>
                                            </Path.Effect>
                                            <Path.CacheMode>
                                                <BitmapCache RenderAtScale="1" SnapsToDevicePixels="True"/>
                                            </Path.CacheMode>
                                        </Path>

                                        <!-- 已选游戏列表 -->
                                        <ScrollViewer x:Name="SelectedGamesScrollViewer" Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Margin="15">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource GameListScrollBarStyle}"/>
                                            </ScrollViewer.Resources>
                                            <StackPanel x:Name="SelectedGamesPanel"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 第五行：操作按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Center">
                        <Button x:Name="ConfirmButton" Content="确 定"
                                Style="{StaticResource ConfirmButtonStyle}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Click="ConfirmButton_Click" Margin="0,0,77,0"/>
                        <Button x:Name="CancelButton" Content="取 消"
                                Style="{StaticResource CancelButtonStyle}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
