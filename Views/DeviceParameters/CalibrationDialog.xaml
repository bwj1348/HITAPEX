<UserControl x:Class="HITAPEX.Views.DeviceParameters.CalibrationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:lex="clr-namespace:HITAPEX.Helpers"
             >

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ClutchGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B6000" Offset="0"/>
            <GradientStop Color="#FFC800" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrakeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#600707" Offset="0"/>
            <GradientStop Color="#C60E0E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThrottleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A6020" Offset="0"/>
            <GradientStop Color="#16C642" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressBgGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#474747" Offset="0"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#99EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="172"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="BtnPath"
                                  Data="M0 6V32H166L172 26V0H6L0 6Z"
                                  Fill="{StaticResource AccentGradient}"
                                  Stretch="Fill"
                                  Width="172" Height="32"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path x:Name="DisabledMask"
                                  Data="M0 6V32H166L172 26V0H6L0 6Z"
                                  Fill="#991B1B1B"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledMask" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

