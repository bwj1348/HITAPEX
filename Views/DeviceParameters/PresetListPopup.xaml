                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <StackPanel x:Name="TabPersonalRow" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Stroke="#EEEEEE" StrokeThickness="1.5"
