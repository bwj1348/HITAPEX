                                    Click="TabPersonal_Click" Margin="0,0,10,0"/>
                        </StackPanel>
                        <Border x:Name="TabPersonalUnderline" Height="3" Background="#C60E0E"
                                HorizontalAlignment="Center" Visibility="Collapsed"
