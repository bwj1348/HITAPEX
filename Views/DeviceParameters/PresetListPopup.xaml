<UserControl x:Class="HITAPEX.Views.DeviceParameters.PresetListPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
             xmlns:lex="clr-namespace:HITAPEX.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="924" d:DesignWidth="1202">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="TitleIconShadow"
                          ShadowDepth="0"
                          BlurRadius="5"
                          Opacity="0.4"
                          Color="#C60E0E"/>

        <!-- 弹窗背景色（模拟亚克力效果，Popup 窗口不支持真实亚克力） -->
        <SolidColorBrush x:Key="DetailPopupBaseBrush" Color="#282D30" Opacity="0.6"/>

        <!-- 预设列表项样式 -->
        <Style x:Key="PresetItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 预设计数角标 -->
        <Style x:Key="PresetCountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 操作按钮样式（筛选 / 取消共用） -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonContainer"
                              SizeChanged="ActionButton_SizeChanged"
                              MinWidth="80" Height="45" HorizontalAlignment="Left">
                            <Canvas>
                                <Path x:Name="BtnPath"
                                      Data="M85 5H14L5 14V50H5.32H76L85 41V5Z"
                                      Fill="#33EEEEEE"
                                      Height="45" Width="80"/>
                            </Canvas>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选项卡按钮样式 -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框样式（参考 TechPresetComboBoxStyle） -->
        <Style x:Key="PresetComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <ControlTemplate.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="#D9D9D9"/>
                                <Setter Property="Width" Value="3"/>
                                <Setter Property="Margin" Value="0,4,2,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" CornerRadius="1.5">
                                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#C60E0E" CornerRadius="1.5" Margin="0"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ControlTemplate.Resources>
                        <Grid x:Name="ComboBoxRoot" SizeChanged="ComboBox_SizeChanged">
                            <Canvas>
                                <Path x:Name="ComboBoxBg" Fill="#EEEEEE" Opacity="0.2"
                                      Height="45" Data="M325 5H14L5 14V50H6.27018H316L325 41V5Z"/>
                            </Canvas>

                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Path HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0" Stroke="#EEEEEE"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Data>
                                    <GeometryGroup>
                                        <PathGeometry Figures="M7.00385 13.2577C10.4578 13.2577 13.2577 10.4578 13.2577 7.00385C13.2577 3.54994 10.4578 0.75 7.00385 0.75C3.54994 0.75 0.75 3.54994 0.75 7.00385C0.75 10.4578 3.54994 13.2577 7.00385 13.2577Z"/>
                                        <PathGeometry Figures="M15.7488 15.7508L11.4219 11.4238"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>

                            <TextBlock x:Name="Watermark" Text="{lex:Loc Preset.FilterGame}" FontSize="22"
                                       Foreground="#99EEEEEE" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Margin="41,0,0,0"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>

                            <TextBlock x:Name="ContentSite" Text="{TemplateBinding SelectionBoxItem}"
                                       TextTrimming="CharacterEllipsis" FontSize="22"
                                       Foreground="#EEEEEE" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Margin="41,0,43,0"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="PART_FilterTextBox"
                                     FontSize="22" FontWeight="Bold"
                                     FontFamily="{StaticResource OrbitronFont}"
                                     Foreground="#EEEEEE"
                                     CaretBrush="#C60E0E"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Margin="41,0,43,0"
                                     Visibility="Collapsed"/>

                            <Path x:Name="Arrow" Data="M13.0605 1.06055L7.06055 7.06055L1.06055 1.06055" Stroke="#EEEEEE" StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" VerticalOffset="-10" PopupAnimation="Fade">
                                <Grid Width="{TemplateBinding ActualWidth}">
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <DrawingBrush Stretch="Fill">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#474747" Geometry="M5 9H316L325 0V170L316 179H5L5 47L5 9Z" />
                                                        <GeometryDrawing Geometry="M325 0L316 9H5">
                                                            <GeometryDrawing.Pen>
                                                                <Pen Brush="#EEEEEE" Thickness="1.5" />
                                                            </GeometryDrawing.Pen>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                        <!--<Rectangle.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5" ShadowDepth="0"/>
                                        </Rectangle.Effect>-->
                                    </Rectangle>

                                    <ScrollViewer Height="179"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Margin="0,15,0,5">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 下拉框展开时：显示筛选文本框（ContentSite/Watermark 由代码根据输入状态控制） -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="PART_FilterTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- 下拉框收起时：隐藏筛选文本框 -->
                            <Trigger Property="IsDropDownOpen" Value="False">
                                <Setter TargetName="PART_FilterTextBox" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding SelectedIndex, RelativeSource={RelativeSource Self}}" Value="-1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Margin="8,2,8,2" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="23"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Path x:Name="CheckMark" Grid.Column="0" Data="M11.75 0.75L5.1532 9.75L0.75 6.37909" Stroke="#EEEEEE" StrokeThickness="1.5" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,5,0,0"/>

                                            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ItemBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#C60E0E" Offset="0"/>
                                                        <GradientStop Color="#600707" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#C60E0E" Offset="0"/>
                                                        <GradientStop Color="#600707" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导入/应用主按钮样式（参考 ActionButtonStyle，背景改为红色渐变） -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonContainer"
                              SizeChanged="AccentButton_SizeChanged"
                              MinWidth="80" Height="45">
                            <Canvas>
                                <Path x:Name="BtnPath"
                                      Data="M85 5H14L5 14V50H5.32H76L85 41V5Z"
                                      Fill="{StaticResource AccentGradient}"
                                      Height="45" Width="80"/>
                            </Canvas>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnPath" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 官方预设项样式 -->
        <Style x:Key="OfficialPresetItemStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="477"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 渐变背景 + 矩形边框 -->
                            <Rectangle x:Name="BgRect" Stroke="#33EEEEEE" StrokeThickness="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1.8,0.5">
                                        <GradientStop Color="#33607079" Offset="0"/>
                                        <GradientStop Color="#333F4A50" Offset="0.44"/>
                                        <GradientStop Color="#33282D30" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <ContentPresenter/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="99"/>
                                <Setter TargetName="BgRect" Property="Stroke" Value="#99C60E0E"/>
                                <Setter TargetName="BgRect" Property="Fill">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33600707" Offset="0"/>
                                            <GradientStop Color="#33C60E0E" Offset="0.5"/>
                                            <GradientStop Color="#33600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 个人预设项样式 -->
        <Style x:Key="PersonalPresetItemStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="477"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 渐变背景 + 矩形边框 -->
                            <Rectangle x:Name="BgRect" Stroke="#33EEEEEE" StrokeThickness="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1.8,0.5">
                                        <GradientStop Color="#33607079" Offset="0"/>
                                        <GradientStop Color="#333F4A50" Offset="0.44"/>
                                        <GradientStop Color="#33282D30" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <ContentPresenter VerticalAlignment="Top" Margin="20"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="99"/>
                                <Setter TargetName="BgRect" Property="Stroke" Value="#99C60E0E"/>
                                <Setter TargetName="BgRect" Property="Fill">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33600707" Offset="0"/>
                                            <GradientStop Color="#33C60E0E" Offset="0.5"/>
                                            <GradientStop Color="#33600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 预设列表滚动条样式 -->
        <Style x:Key="PresetScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="MinWidth" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#CCEEEEEE" CornerRadius="1.5" Width="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Width="3"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E6C60E0E" CornerRadius="1.5" Width="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Width="3"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 根层：覆盖整个父容器 -->
    <Grid>
        <!-- 半透明遮罩层 -->
        <Border x:Name="OverlayBackground" Background="#991B1B1B"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                Cursor="Hand"/>

        <!-- 弹窗主体：右侧面板 -->
        <Border x:Name="PopupPanel"
                Width="540" Height="924"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="Arrow"
                ClipToBounds="True">
            <Border.CacheMode>

                <BitmapCache RenderAtScale="1" EnableClearType="False"/>

            </Border.CacheMode>

            <Grid>
                <!-- 背景层：渐变 + SVG 图案 -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.3,0.7" EndPoint="1,1">
                            <GradientStop Color="#0B0B0B" Offset="0"/>
                            <GradientStop Color="#343434" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <svgc:SvgViewbox Source="/Assets/Group126548717.svg" Stretch="Fill"/>

                <!-- 内容层 -->
                <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：图标 + "预设列表" -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="0,0,20,0">
                        <Path.Data>
                            <GeometryGroup>
                                <PathGeometry Figures="M17.0314,0.75H0.75"/>
                                <PathGeometry Figures="M17.0337,6.75H7.64062"/>
                                <PathGeometry Figures="M17.0337,12.75H7.64062"/>
                                <PathGeometry Figures="M17.0314,18.75H0.75"/>
                                <PathGeometry Figures="M2.625,6.75L5.12983,9.75L2.625,12.75"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <TextBlock Text="{lex:Loc Preset.Title}" FontSize="26" FontWeight="Bold"
                               Foreground="#EEEEEE" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 第二行：下拉框 + 筛选按钮 + 取消按钮 -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CategoryComboBox" Grid.Column="0"
                              Style="{StaticResource PresetComboBoxStyle}" Margin="0,0,10,0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CategoryComboBox_SelectionChanged"/>

                    <Button x:Name="FilterButton" Grid.Column="1"
                            Content="{lex:Loc Preset.Filter}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"
                            Click="FilterButton_Click"/>

                    <Button x:Name="CancelButton" Grid.Column="2"
                            Content="{lex:Loc Preset.Cancel}" Style="{StaticResource ActionButtonStyle}"
                            Click="CancelButton_Click"/>
                </Grid>

                <!-- 第四行：预设列表 -->
                <ScrollViewer x:Name="PresetScrollViewer" Grid.Row="3"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PresetItemsControl" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 滚动条（跨越第三行和第四行） -->
                <ScrollBar x:Name="PresetScrollBar"
                           Grid.Row="2" Grid.RowSpan="2"
                           HorizontalAlignment="Right"
                           Width="3"
                           Orientation="Vertical"
                           Style="{StaticResource PresetScrollBarStyle}"
                           SmallChange="1"
                           LargeChange="10"
                           Scroll="PresetScrollBar_Scroll"/>

                <!-- 第三行：选项卡（官方预设 / 个人预设，位于滚动条上方） -->
                <Grid Grid.Row="2" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 官方预设 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <StackPanel x:Name="TabOfficialRow" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Margin="6,0,6,0">
                                <Path.Data>
                                    <GeometryGroup>
