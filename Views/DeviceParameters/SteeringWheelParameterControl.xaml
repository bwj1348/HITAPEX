<UserControl x:Class="HITAPEX.Views.DeviceParameters.SteeringWheelParameterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="884" d:DesignWidth="1202"
             Background="Transparent">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabSelectedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A5568"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1A202C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ActionButtonPathStyle" TargetType="Path">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#C60E0E" Offset="0"/>
                        <GradientStop Color="#600707" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Stretch" Value="Fill"/>
        </Style>

        <Style x:Key="PresetListButtonPathStyle" TargetType="Path">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#C60E0E" Offset="0"/>
                        <GradientStop Color="#600707" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Stretch" Value="Fill"/>
        </Style>

        <!-- 选项卡样式（左） -->
        <Style x:Key="SectionTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Width" Value="246"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="246" Height="45">
                            <Path x:Name="ButtonPath"
                                  Data="M15.9058 1.5H236.7C237.984 1.5 239.165 2.20315 239.777 3.33203L243.752 10.666C244.245 11.5751 244.31 12.6562 243.931 13.6182L233.025 41.2832C232.498 42.6205 231.207 43.4999 229.769 43.5H8.9751C7.69107 43.4999 6.50985 42.7968 5.89795 41.668L1.92236 34.334C1.42962 33.4249 1.36443 32.3438 1.74365 31.3818L12.6499 3.7168C13.1771 2.37956 14.4684 1.50019 15.9058 1.5Z"
                                  Stretch="Fill"
                                  Fill="Transparent"
                                  Stroke="{StaticResource TabSelectedGradient}"
                                  StrokeThickness="3"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="#FFFFFF"
                                      TextElement.FontWeight="Bold"
                                      TextElement.FontSize="22"
                                      TextElement.FontStyle="Italic"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill" Value="{StaticResource TabSelectedGradient}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选项卡样式（右） -->
        <Style x:Key="SectionTabStyle2" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Width" Value="246"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="244" Height="45">
                            <Path x:Name="ButtonPath"
                                  Data="M12.5693 1.5H234.862C236.146 1.5001 237.328 2.20313 237.939 3.33203L241.914 10.666C242.407 11.575 242.472 12.6553 242.093 13.6172L231.188 41.2832C230.66 42.6205 229.369 43.4998 227.932 43.5H5.00488C2.53554 43.4999 0.843171 41.0117 1.75 38.7148L11.2217 14.7236C11.9285 12.9335 11.8061 10.9222 10.8867 9.23145L9.49512 6.67188C8.22694 4.33976 9.91476 1.5002 12.5693 1.5Z"
                                  Stretch="Fill"
                                  Fill="Transparent"
                                  Stroke="{StaticResource TabSelectedGradient}"
                                  StrokeThickness="3"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="#FFFFFF"
                                      TextElement.FontWeight="Bold"
                                      TextElement.FontSize="22"
                                      TextElement.FontStyle="Italic"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill" Value="{StaticResource TabSelectedGradient}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形按键样式 (26×26) — 视觉效果仅由 HID 数据驱动，点击不产生选中效果 -->
        <Style x:Key="SmallButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="GlowCircle" Width="44" Height="44" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                         RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#940A0A" Offset="0.63"/>
                                        <GradientStop Color="#33940A0A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing" Fill="#C60E0E"
                                     Width="32" Height="32" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="ButtonCircle" Fill="#1B1B1B" Width="26" Height="26"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#AAAAAA"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Bold"
                                              TextElement.FontFamily="{StaticResource OrbitronFont}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形大按键样式 (43×43) — 视觉效果仅由 HID 数据驱动，点击不产生选中效果 -->
        <Style x:Key="LargeButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="GlowCircle" Width="65" Height="65" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                         RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#940A0A" Offset="0.63"/>
                                        <GradientStop Color="#33940A0A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing" Fill="#C60E0E" Visibility="Collapsed"
                                     Width="51" Height="51"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="ButtonCircle" Fill="#1B1B1B" Width="43" Height="43"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#AAAAAA"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Bold"
                                              TextElement.FontFamily="{StaticResource OrbitronFont}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上箭头按键样式 (B4, B14) -->
        <Style x:Key="ArrowUpButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ArrowPath" Width="14" Height="8"
                                  Data="M1 6L6.5 1L12 6"
                                  Stretch="Uniform"
                                  Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                              TextElement.Foreground="#EEEEEE"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Bold"
                                              TextElement.FontFamily="{StaticResource OrbitronFont}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下箭头按键样式 (B5, B15) -->
        <Style x:Key="ArrowDownButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ArrowPath" Width="14" Height="8"
                              Data="M1 1L6.5 6L12 1"
                              Stretch="Uniform"
                              Stroke="#EEEEEE" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                          TextElement.Foreground="#EEEEEE"
                                          TextElement.FontSize="12"
                                          TextElement.FontWeight="Bold"
                                          TextElement.FontFamily="{StaticResource OrbitronFont}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DualStateSvgToggleStyle -->
        <Style x:Key="DualStateSvgToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Viewbox Stretch="Fill">
                            <Grid Width="46" Height="24">
                                <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#C60E0E" Stroke="#801111" StrokeThickness="1"/>
                                <Path Data="M0.640625 23.5L6.39062 0.5H25.3594L19.6094 23.5H0.640625Z" Fill="#22C55E" Stroke="#1F6B3B" StrokeThickness="1"/>
                                <Path Opacity="0.2" Fill="Black" Data="M6.06897 8H14L16 0H13.931H6L4 8H6.06897Z M14.069 16H22L24 8H21.931H14L12 16H14.069Z M34.069 16H42L44 8H41.931H34L32 16H34.069Z M2.06897 24H10L12 16H9.93103H2L0 24H2.06897Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>
                                <Grid x:Name="ThumbContainer">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="-20"/>
                                    </Grid.RenderTransform>
                                    <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#727273" Stroke="#424242" StrokeThickness="1"/>
                                    <Path Opacity="0.2" Fill="Black" Data="M34.069 16H42L44 8H41.931H34L32 16H34.069Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>
                                </Grid>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="-20" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 亮度滑块样式 -->
        <Style x:Key="BrightnessSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="345"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="50"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="15" VerticalAlignment="Center" SnapsToDevicePixels="True">

                            <Track x:Name="PART_Track" VerticalAlignment="Center" Margin="-7.5,0,-7.5,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Margin="7.5,0,-7.5,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#600707" Offset="0"/>
                                                            <GradientStop Color="#C60E0E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="#EEEEEE" Margin="-7.5,0,7.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="15" Height="15" Fill="#C60E0E" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 色块单选样式 -->
        <Style x:Key="ColorBlockRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,-6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="50" Height="35">
                            <Path x:Name="LargeBorder" Data="M1.38327 34L12.2817 1H48.7065L37.8071 34H1.38327Z"
                                  Stroke="{TemplateBinding Background}" StrokeThickness="10" Fill="Transparent" Stretch="None">
                                <Path.Clip>
                                    <PathGeometry Figures="M1.38327 34L12.2817 1H48.7065L37.8071 34H1.38327Z"/>
                                </Path.Clip>
                            </Path>
                            <Path x:Name="SmallFill" Data="M17.1936 31.1113H35.5979L44.6442 3.88911H38.9253H14.4901L5.44388 31.1113H17.1936Z"
                                  Fill="{TemplateBinding Background}" Stretch="None"/>
                            <Path x:Name="DisabledOverlay"
                                  Data="M1.38327 34L12.2817 1H48.7065L37.8071 34H1.38327Z"
                                  Fill="#991B1B1B" Stretch="None"
                                  Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LargeBorder" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 速度滑块样式（锯齿形分段轨道 + 三角形滑块） -->
        <Style x:Key="SpeedSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="341"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="5"/>
            <Setter Property="Value" Value="3"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <EventSetter Event="ValueChanged" Handler="SpeedSlider_ValueChanged"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="33" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid.Resources>
                                <GeometryGroup x:Key="TrackGeometry">
                                    <PathGeometry Figures="M0 0H65.5768L61.9999 5H0V0Z"/>
                                    <PathGeometry Figures="M72.7297 0H134.73L131.153 5H69.1528L72.7297 0Z"/>
                                    <PathGeometry Figures="M141.885 0H202.692L199.115 5H138.308L141.885 0Z"/>
                                    <PathGeometry Figures="M67.9629 0H70.3475L66.7706 5H64.386L67.9629 0Z"/>
                                    <PathGeometry Figures="M137.116 0H139.5L135.923 5H133.539L137.116 0Z"/>
                                    <PathGeometry Figures="M209.847 0H271.847L268.27 5H206.27L209.847 0Z"/>
                                    <PathGeometry Figures="M205.076 0H207.461L203.884 5H201.5L205.076 0Z"/>
                                    <PathGeometry Figures="M279 0H341V5H275.423L279 0Z"/>
                                    <PathGeometry Figures="M274.229 0H276.614L273.037 5H270.652L274.229 0Z"/>
                                </GeometryGroup>
                            </Grid.Resources>

                            <!-- 唯一的轨道路径，通过渐变填充 -->
                            <Viewbox Height="5" VerticalAlignment="Top" Stretch="Fill">
                                <Path Data="{StaticResource TrackGeometry}"
                                      Width="341" Height="5" Stretch="None">
                                    <Path.Fill>
                                        <LinearGradientBrush x:Name="TrackFillBrush"
                                                             StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#600707" Offset="0"/>
                                            <GradientStop Color="#C60E0E" Offset="0.5"/>
                                            <GradientStop Color="#EEEEEE" Offset="0.5"/>
                                            <GradientStop Color="#EEEEEE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Viewbox>

                            <!-- Track 仅用于交互，不绘制轨道 -->
                            <Track x:Name="PART_Track" VerticalAlignment="Stretch" Margin="-10,0,-10,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="20" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Canvas Width="20" Height="18"
                                                        Background="Transparent" Cursor="Hand">
                                                    <Path Data="M19.1494 17.5H0.850586L10 1.03027L19.1494 17.5Z"
                                                          Stroke="#C60E0E" StrokeThickness="1"
                                                          Width="20" Height="18" Stretch="None"/>
                                                    <Path Data="M4 16L10 4L16 16H4Z"
                                                          Fill="#C60E0E"
                                                          Width="20" Height="18" Stretch="None"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 遥测效果 开始/暂停 按钮样式 -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
