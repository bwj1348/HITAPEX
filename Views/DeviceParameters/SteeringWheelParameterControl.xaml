<UserControl x:Class="HITAPEX.Views.DeviceParameters.SteeringWheelParameterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 设备信息区 -->
        <Grid Grid.Row="0" Margin="0,0,0,19">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <svgc:SvgViewbox Source="/Assets/Group126547702.svg" Width="27.63" Height="18" Margin="0,0,8.24,3" VerticalAlignment="Bottom"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="面 盘" FontSize="26" Foreground="#EEEEEE" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DeviceModelName" Text="面盘" FontSize="26" Foreground="#EEEEEE" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource OrbitronFont}"/>
                </StackPanel>

                <Border Grid.Column="2" Width="1" Height="26" Background="#EEEEEE" Margin="20,0,20,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="26" Margin="0,0,10,0">
                        <Canvas Width="22" Height="26">
                            <Path x:Name="ConnStatusIcon1" Data="M3.40006 11.8001C4.72555 11.8001 5.80012 10.7256 5.80012 9.40006C5.80012 8.07457 4.72555 7 3.40006 7C2.07454 7 1 8.07457 1 9.40006C1 10.7256 2.07454 11.8001 3.40006 11.8001Z"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon2" Data="M17.8024 15.3997C19.1279 15.3997 20.2025 14.3252 20.2025 12.9997C20.2025 11.6742 19.1279 10.5996 17.8024 10.5996C16.4769 10.5996 15.4023 11.6742 15.4023 12.9997C15.4023 14.3252 16.4769 15.3997 17.8024 15.3997Z"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon3" Data="M7.60156 4.00007L10.6016 1L13.6017 4.00007"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon4" Data="M11.2025 22.001L3.40234 15.5588V11.8008"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon5" Data="M17.8017 15.4004V18.2742L10.6016 23.2006"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon6" Data="M10.6016 1V24.4006"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ConnStatusIcon7" Data="M8.80078 25H12.4009"
                                  Stroke="#C60E0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ConnectionStatusText" Text="未连接" FontSize="22" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="5" Width="1" Height="26" Background="#EEEEEE" Margin="20,0,20,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="固件版本:" FontSize="22" Foreground="#80EEEEEE" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FirmwareVersionText" Text="---" FontSize="22" Foreground="#EEEEEE" Margin="5,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource OrbitronFont}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#99383838" Margin="0,4,0,0" CornerRadius="1"/>
        </Grid>
    </Grid>
</UserControl>
