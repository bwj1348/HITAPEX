                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="#EEEEEE" Margin="0,0,0,10"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <RadioButton x:Name="StrobeColor1" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#C60E0E" IsChecked="True"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor2" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#FF6A00"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor3" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#FFC800"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor4" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#16C642"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor5" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#28F9DD"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor6" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#2840F9"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor7" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#C128F9"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor8" GroupName="StrobeColor"
                                                         Style="{StaticResource PopupColorBlockRadioStyle}"
                                                         Background="#EEEEEE"
                                                         Checked="StrobeColor_Checked"/>
                                            <RadioButton x:Name="StrobeColor9" GroupName="StrobeColor"
                                                         Style="{StaticResource RpmColorBlockCustomStyle}"
                                                         Background="#373737"
                                                         Checked="StrobeColor_Checked"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 第六行：速度 -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=RpmTelemetryToggle}" Value="False">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#80000000"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=StrobeModeComboBox}" Value="2">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#80000000"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="速度"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="#EEEEEE" Margin="0,0,0,10"/>
                                        <Slider x:Name="RpmSpeedSlider1" Grid.Row="1"
                                                Style="{StaticResource PopupSpeedSliderStyle}"
                                                Value="3" Width="282" ValueChanged="SpeedSlider_ValueChanged"/>
                                    </Grid>

                                    <!-- 第七行：基础灯光 -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                            <Viewbox Width="8" Height="26" Margin="0,0,10,0">
                                                <Grid Width="8" Height="26" Opacity="0.9">
                                                    <Grid.Effect>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="#C60E0E" Opacity="0.4"/>
                                                    </Grid.Effect>
                                                    <Path Data="M0 2L2 0H4L0 4V2Z M8 0H6L0 6V26H5L8 23V0Z">
                                                        <Path.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#C60E0E" Offset="0"/>
                                                                <GradientStop Color="#600707" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Path.Fill>
                                                    </Path>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="遥 测 模 式" FontSize="18" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Row="1" x:Name="BaseLightModeComboBox"
                                                  Style="{StaticResource PopupComboBoxStyle}"
                                                  SelectedIndex="0" Width="300" Height="35"
                                                  SelectionChanged="BaseLightModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="恒亮"/>
                                            <ComboBoxItem Content="呼吸"/>
                                            <ComboBoxItem Content="彩色循环"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- 第八行：速度 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=BaseLightModeComboBox}" Value="0">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#80000000"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="速度"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="#EEEEEE" Margin="0,0,0,10"/>
                                        <Slider x:Name="RpmSpeedSlider2" Grid.Row="1"
                                                Style="{StaticResource PopupSpeedSliderStyle}"
                                                Value="3" Width="282" ValueChanged="SpeedSlider_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 底部按钮 -->
                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="77"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PopupConfirmButtonStyle}"
                                Content="确 定"
                                Click="ConfirmButton_Click"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource PopupCancelButtonStyle}"
                                Content="取 消"
                                Click="CancelButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
