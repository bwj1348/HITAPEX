<UserControl x:Class="HITAPEX.Views.DeviceParameters.RpmSettingsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="704" d:DesignWidth="1047">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66C60E0E" Offset="0"/>
            <GradientStop Color="#66600707" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ColorBlockHeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#33EEEEEE" Offset="0"/>
            <GradientStop Color="#331B1B1B" Offset="0.3"/>
            <GradientStop Color="#33000000" Offset="0.5"/>
            <GradientStop Color="#331B1B1B" Offset="0.7"/>
            <GradientStop Color="#33EEEEEE" Offset="1"/>
        </LinearGradientBrush>

        <!-- 确认按钮 -->
        <Style x:Key="PopupConfirmButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="173"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path Data="M0 6V32H166L172 26V0H6L0 6Z" Stretch="Fill" Width="173" Height="32">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C60E0E" Offset="0"/>
                                        <GradientStop Color="#600707" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮 -->
        <Style x:Key="PopupCancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="173"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path Data="M0 6V32H166L172 26V0H6L0 6Z"
                                  Fill="#33EEEEEE"
                                  Stretch="Fill" Width="173" Height="32"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 竖向滑块样式 -->
        <Style x:Key="VerticalRpmSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="315"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="80"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="16" Height="315">
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                        Width="6" CornerRadius="3"
                                                        HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#99EEEEEE"
                                                        Width="6" CornerRadius="3"
                                                        HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Margin="0,-8,0,-8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16" Cursor="Hand">
                                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                             StrokeThickness="1"
                                                             Width="16" Height="16" Fill="Transparent"/>
                                                    <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                             Width="12" Height="12"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 中间色块样式（圆角矩形，一大一小两个图形） -->
        <Style x:Key="RpmColorBlockMidStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="12,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Viewbox Width="22" Height="32" Stretch="Uniform">
                            <Grid Width="22" Height="32">
                                <!-- 大圆角矩形：粗边框，透明填充 -->
                                <Path x:Name="LargeBorder"
                                      Stroke="{TemplateBinding Background}"
                                      StrokeThickness="10"
                                      Fill="Transparent"
                                      Stretch="None">
                                    <Path.Data>
                                        <RectangleGeometry Rect="0,0,22,32" RadiusX="2" RadiusY="2"/>
                                    </Path.Data>
                                    <Path.Clip>
                                        <RectangleGeometry Rect="0,0,22,32" RadiusX="2" RadiusY="2"/>
                                    </Path.Clip>
                                </Path>
                                <!-- 小圆角矩形：实体填充 -->
                                <Path x:Name="SmallFill"
                                      Fill="{TemplateBinding Background}"
                                      Stretch="None">
                                    <Path.Data>
                                        <RectangleGeometry Rect="3,3,16,26" RadiusX="2" RadiusY="2"/>
                                    </Path.Data>
                                </Path>
                                <!-- 禁用遮罩 -->
                                <Path x:Name="DisabledOverlay"
                                      Fill="#991B1B1B"
                                      Stretch="Fill"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False">
                                    <Path.Data>
                                        <RectangleGeometry Rect="0,0,22,32" RadiusX="2" RadiusY="2"/>
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LargeBorder" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最左侧色块样式 -->
        <Style x:Key="RpmColorBlockLeftStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Viewbox Width="28" Height="32" Stretch="Uniform">
                            <Grid Width="28" Height="32">
                                <Path x:Name="LargeBorder" Data="M2.63672 31.25H26C26.6904 31.25 27.25 30.6904 27.25 30V2C27.25 1.30964 26.6904 0.75 26 0.75H10.4766C9.91616 0.75016 9.42455 1.12341 9.27344 1.66309L1.43359 29.6631C1.21045 30.4601 1.80911 31.2499 2.63672 31.25Z"
                                      Stroke="{TemplateBinding Background}" StrokeThickness="10" Fill="Transparent"
                                      Stretch="None">
                                    <Path.Clip>
                                        <PathGeometry Figures="M2.63672 31.25H26C26.6904 31.25 27.25 30.6904 27.25 30V2C27.25 1.30964 26.6904 0.75 26 0.75H10.4766C9.91616 0.75016 9.42455 1.12341 9.27344 1.66309L1.43359 29.6631C1.21045 30.4601 1.80911 31.2499 2.63672 31.25Z"/>
                                    </Path.Clip>
                                </Path>
                                <Path x:Name="SmallFill" Data="M4.32314 27.7498C4.15952 28.3828 4.63747 29 5.29132 29H24C24.5523 29 25 28.5523 25 28V4C25 3.44772 24.5523 3 24 3H11.4944C11.0385 3 10.6403 3.30836 10.5262 3.74976L4.32314 27.7498Z"
                                      Fill="{TemplateBinding Background}" Stretch="None"/>
                                <Path x:Name="DisabledOverlay"
                                      Data="M2.63672 31.25H26C26.6904 31.25 27.25 30.6904 27.25 30V2C27.25 1.30964 26.6904 0.75 26 0.75H10.4766C9.91616 0.75016 9.42455 1.12341 9.27344 1.66309L1.43359 29.6631C1.21045 30.4601 1.80911 31.2499 2.63672 31.25Z"
                                      Fill="#991B1B1B" Stretch="None"
                                      Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LargeBorder" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最右侧色块样式 -->
        <Style x:Key="RpmColorBlockRightStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Viewbox Width="28" Height="32" Stretch="Uniform">
                            <Grid Width="28" Height="32">
                                <Path x:Name="LargeBorder" Data="M27.289 29.4607C27.6461 30.736 26.6874 32 25.3631 32H2C0.895432 32 0 31.1046 0 30V2C0 0.89543 0.89543 0 2 0H17.5231C18.42 0 19.2072 0.597073 19.449 1.46074L27.289 29.4607Z"
                                      Stroke="{TemplateBinding Background}" StrokeThickness="10" Fill="Transparent"
                                      Stretch="None">
                                    <Path.Clip>
                                        <PathGeometry Figures="M27.289 29.4607C27.6461 30.736 26.6874 32 25.3631 32H2C0.895432 32 0 31.1046 0 30V2C0 0.89543 0.89543 0 2 0H17.5231C18.42 0 19.2072 0.597073 19.449 1.46074L27.289 29.4607Z"/>
                                    </Path.Clip>
                                </Path>
                                <Path x:Name="SmallFill" Data="M23.67686 27.7498C23.84048 28.3828 23.36253 29 22.70868 29H4C3.4477 29 3 28.5523 3 28V4C3 3.44772 3.4477 3 4 3H16.5056C16.9615 3 17.3597 3.30836 17.4738 3.74976L23.67686 27.7498Z"
                                      Fill="{TemplateBinding Background}" Stretch="None"/>
                                <Path x:Name="DisabledOverlay"
                                      Data="M27.289 29.4607C27.6461 30.736 26.6874 32 25.3631 32H2C0.895432 32 0 31.1046 0 30V2C0 0.89543 0.89543 0 2 0H17.5231C18.42 0 19.2072 0.597073 19.449 1.46074L27.289 29.4607Z"
                                      Fill="#991B1B1B" Stretch="None"
                                      Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LargeBorder" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 曲线类型单选样式（复用踏板曲线选择外观） -->
        <Style x:Key="CurveTypeRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="25" Height="25">
                            <Path x:Name="DefaultBorder" Data="M0,0 L46,0 L46,46 L0,46 Z" Stretch="Fill"
                                  Fill="#33EEEEEE" Stroke="#EEEEEE" StrokeThickness="0.5"/>
                            <Path x:Name="SelectedBorder"
                                  Data="M45.5 0.5V39.793L39.793 45.5H0.5V6.24023L6.20801 0.5H45.5Z"
                                  Fill="{StaticResource AccentGradient}" Stretch="Fill"
                                  Stroke="#C60E0E" StrokeThickness="1"
                                  Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DefaultBorder" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模式单选样式（参考拨片模式） -->
        <Style x:Key="PaddleModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="22" Height="18">
                            <Path x:Name="OuterBorder"
                                  Data="M20.7889 0.724723L20.5962 1.44828L16.6017 16.4486L16.4085 17.174H0.942669L1.13536 16.4504L5.13085 1.45016L5.32405 0.724723H20.7889Z"
                                  Stroke="#C60E0E" StrokeThickness="1.5"
                                  Fill="Transparent" Stretch="None"/>
                            <Path x:Name="InnerFill"
                                  Data="M14.984 0H3.49626L0 13H11.5044L14.984 0Z"
                                  Fill="#C60E0E" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerFill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 色块单选样式（复用按键灯颜色） -->
        <Style x:Key="PopupColorBlockRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="37"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,-4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="37" Height="35">
                            <Path x:Name="LargeBorder" Data="M1.26842 34L9.18248 1H35.1034L27.1893 34H1.26842Z"
                                  Stroke="{TemplateBinding Background}" StrokeThickness="10" Fill="Transparent" Stretch="None">
                                <Path.Clip>
                                    <PathGeometry Figures="M1.26842 34L9.18248 1H35.1034L27.1893 34H1.26842Z"/>
                                </Path.Clip>
                            </Path>
                            <Path x:Name="SmallFill" Data="M8.53195 27.2227H21.8961L28.465 0.000434875H24.3123H6.56884L0 27.2227H8.53195Z" Width="28" Height="27.5"
                                  Fill="{TemplateBinding Background}" Stretch="Fill" Margin="1,1,1.5,1"/>
                            <Path x:Name="DisabledOverlay"
                                  Data="M1.26842 34L9.18248 1H35.1034L27.1893 34H1.26842Z"
                                  Fill="#991B1B1B" Stretch="None"
                                  Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LargeBorder" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 第九个色块自定义样式 -->
        <Style x:Key="RpmColorBlockCustomStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="37"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="37" Height="35">
                            <Path x:Name="OuterPath" Data="M1.26842 34L9.18249 1H35.1034L27.1893 34H1.26842Z"
                                  Fill="#969696" Stroke="#5A5A5A" StrokeThickness="2" Stretch="None"/>
                            <Path Opacity="0.2" Fill="Black" Stretch="None"
                                  Data="M19.6913 23.332H30.7852L33.5828 11.666H30.6887H19.5948L16.7972 23.332H19.6913Z"/>
                            <Path Opacity="0.2" Fill="Black" Stretch="None"
                                  Data="M2.90293 35H13.9969L16.7945 23.334H13.9004H2.80646L0.00886154 35H2.90293Z"/>
                            <Path Opacity="0.2" Fill="Black" Stretch="None"
                                  Data="M8.49962 11.668H19.5935L22.3911 0.00193119H19.4971H8.40315L5.60555 11.668H8.49962Z"/>
                            <Path x:Name="DisabledOverlay"
                                  Data="M1.26842 34L9.18249 1H35.1034L27.1893 34H1.26842Z"
                                  Fill="#991B1B1B" Stretch="None"
                                  Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterPath" Property="Stroke" Value="#80000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DualStateSvgToggleStyle -->
        <Style x:Key="PopupDualStateSvgToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Viewbox Stretch="Fill">
                            <Grid Width="46" Height="24">
                                <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#C60E0E" Stroke="#801111" StrokeThickness="1"/>
                                <Path Data="M0.640625 23.5L6.39062 0.5H25.3594L19.6094 23.5H0.640625Z" Fill="#22C55E" Stroke="#1F6B3B" StrokeThickness="1"/>
                                <Path Opacity="0.2" Fill="Black" Data="M6.06897 8H14L16 0H13.931H6L4 8H6.06897Z M14.069 16H22L24 8H21.931H14L12 16H14.069Z M34.069 16H42L44 8H41.931H34L32 16H34.069Z M2.06897 24H10L12 16H9.93103H2L0 24H2.06897Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>
                                <Grid x:Name="ThumbContainer">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="-20"/>
                                    </Grid.RenderTransform>
                                    <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#727273" Stroke="#424242" StrokeThickness="1"/>
                                    <Path Opacity="0.2" Fill="Black" Data="M34.069 16H42L44 8H41.931H34L32 16H34.069Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>
                                </Grid>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="-20" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框样式 -->
        <Style x:Key="PopupComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <ControlTemplate.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="#D9D9D9"/>
                                <Setter Property="Width" Value="3"/>
                                <Setter Property="Margin" Value="0,4,8,4"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" CornerRadius="1.5">
                                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#C60E0E" CornerRadius="1.5" Margin="0"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ControlTemplate.Resources>
                        <Grid>
                            <Grid>
                                <Border Background="#EEEEEE" Opacity="0.2" Margin="6,0,6,0"/>
                                <Polygon Points="0,6 6,0 6,6" Fill="#EEEEEE" Opacity="0.2"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Background="#EEEEEE" Opacity="0.2" Width="6"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                <Border Background="#EEEEEE" Opacity="0.2" Width="6"
                                        HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                <Polygon Points="0,0 6,0 0,6" Fill="#EEEEEE" Opacity="0.2"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>

                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
