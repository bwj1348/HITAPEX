                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Text" Value="{lex:Loc Common.Launch}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                        <Setter Property="Text" Value="{lex:Loc Common.NotInstalled}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#991B1B1B" MinHeight="246">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M25 0 A25 25 0 0 1 50 25" Stroke="#C60E0E" StrokeThickness="3" Fill="Transparent" Width="50" Height="50" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingOverlayRotate" Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=LoadingOverlay}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="LoadingStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="LoadingStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{lex:Loc Home.LoadingGames}" FontSize="14" Foreground="#EEEEEE" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid x:Name="ScrollbarTrack" Height="10" VerticalAlignment="Center">
                        <Border x:Name="ScrollbarThumb" Background="#8FFF0000" Height="10" Width="100" HorizontalAlignment="Left" Cursor="Hand" 
                                MouseLeftButtonDown="ScrollbarThumb_MouseLeftButtonDown" MouseMove="ScrollbarThumb_MouseMove" MouseLeftButtonUp="ScrollbarThumb_MouseLeftButtonUp">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-20"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
