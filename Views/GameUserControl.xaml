<UserControl x:Class="HITAPEX.Views.GameUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
             xmlns:controls="clr-namespace:HITAPEX.Controls"
             xmlns:lex="clr-namespace:HITAPEX.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="924" d:DesignWidth="1342"
             Loaded="GameUserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="130" Height="27">
                            <Path x:Name="ButtonPath" Data="M130 21V0H5.99988L0 6V27H124L130 21Z" Stretch="Fill">
                                <Path.Fill>
                                    <SolidColorBrush Color="#3B3B3B" Opacity="0.8"/>
                                </Path.Fill>
                            </Path>
                            <TextBlock Text="{TemplateBinding Content}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#EEEEEE"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C60E0E" Offset="0"/>
                                            <GradientStop Color="#600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DualStateSvgToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34.5"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Viewbox Stretch="Fill">
                            <Grid Width="46" Height="24">

                                <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#C60E0E" Stroke="#801111" StrokeThickness="1"/>
                                <Path Data="M0.640625 23.5L6.39062 0.5H25.3594L19.6094 23.5H0.640625Z" Fill="#22C55E" Stroke="#1F6B3B" StrokeThickness="1"/>
                                <Path Opacity="0.2" Fill="Black" Data="M6.06897 8H14L16 0H13.931H6L4 8H6.06897Z M14.069 16H22L24 8H21.931H14L12 16H14.069Z M34.069 16H42L44 8H41.931H34L32 16H34.069Z M2.06897 24H10L12 16H9.93103H2L0 24H2.06897Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>

                                <Grid x:Name="ThumbContainer">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="-20"/>
                                    </Grid.RenderTransform>
                                    <Path Data="M20.6406 23.5L26.3906 0.5H45.3594L39.6094 23.5H20.6406Z" Fill="#727273" Stroke="#424242" StrokeThickness="1"/>
                                    <Path Opacity="0.2" Fill="Black" Data="M34.069 16H42L44 8H41.931H34L32 16H34.069Z M22.069 24H30L32 16H29.931H22L20 24H22.069Z M26.069 8H34L36 0H33.931H26L24 8H26.069Z"/>
                                </Grid>

                            </Grid>
                        </Viewbox>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                     Storyboard.TargetProperty="X" 
                                                     To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                     Storyboard.TargetProperty="X" 
                                                     To="-20" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="BackgroundGrid" Grid.RowSpan="3" Width="1285" Height="723" VerticalAlignment="Top" Margin="0,23,0,0" Background="Transparent">

            <Border.OpacityMask>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                    <GradientStop Color="#D9FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#CCFFFFFF" Offset="0.52"/>
                    <GradientStop Color="#B3FFFFFF" Offset="0.69"/>
                    <GradientStop Color="#99FFFFFF" Offset="0.77"/>
                    <GradientStop Color="#80FFFFFF" Offset="0.81"/>
                    <GradientStop Color="#66FFFFFF" Offset="0.85"/>
                    <GradientStop Color="#33FFFFFF" Offset="0.92"/>
                    <GradientStop Color="#1AFFFFFF" Offset="0.96"/>
                    <GradientStop Color="#0DFFFFFF" Offset="0.98"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.OpacityMask>

            <Image x:Name="GameBackgroundImage" Stretch="Fill"/>
        </Border>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="82" Margin="0,0,0,20">
                        <Canvas ClipToBounds="False">
                            <TextBlock x:Name="GameTitleText2" Text="" FontSize="64" FontWeight="Black" 
                                       FontFamily="{StaticResource OrbitronFont}" FontStyle="Italic" Margin="5,5,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF003C" BlurRadius="5" ShadowDepth="0" Opacity="1"/>
                                </TextBlock.Effect>
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#C60E0E" Offset="0"/>
                                        <GradientStop Color="#600707" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>

                            <TextBlock x:Name="GameTitleText" Text="" FontSize="64" FontWeight="Black" 
                                       Foreground="#EEEEEE" FontFamily="{StaticResource OrbitronFont}" FontStyle="Italic"
                                       TextTrimming="None" TextWrapping="NoWrap"/>
                        </Canvas>
                    </Grid>

                    <Border Grid.Row="1"  Margin="0,0,0,40">
                        <TextBlock x:Name="GameDescriptionText" Text=""
                                   FontSize="16" 
                                   Foreground="#EEEEEE" 
                                   TextWrapping="Wrap"
                                   LineHeight="23"
                                   Height="120" Width="437"
                                   HorizontalAlignment="Left"
                                   FontFamily="{StaticResource OrbitronFont}"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid x:Name="LaunchButtonContainer" Width="300" Height="47" Cursor="Hand" MouseLeftButtonDown="LaunchGameButton_Click" HorizontalAlignment="Left">
                            <Path x:Name="LaunchButtonPath" Data="M 12,0 L 300,0 L 288,47 L 0,47 Z" Stretch="Fill" Fill="#C60E0E" Opacity="0.8"/>
                            <Path x:Name="LaunchButtonPathNotInstalled" Data="M 12,0 L 300,0 L 288,47 L 0,47 Z" Stretch="Fill" Fill="#B5B5B5" Opacity="0.6" Visibility="Collapsed"/>
                            <svgc:SvgViewbox Source="/Assets/Group126547700.svg" Stretch="Fill"/>
                            <TextBlock x:Name="LaunchButtonText" Text="{lex:Loc Game.LaunchGame}" FontSize="30" FontWeight="Bold" Foreground="#EEEEEE" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <RadioButton x:Name="SteamLaunchRadio" Content="{lex:Loc Game.FromSteam}" Foreground="#EEEEEE" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0" Checked="LaunchModeRadio_Changed" Cursor="Hand">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                                        <Grid Width="22" Height="18" Margin="0,0,8,0">
                                                            <Path x:Name="RadioOuter" Data="M20.8093 0.724774L20.6165 1.44828L16.6167 16.4484L16.4233 17.1738H0.942858L1.13574 16.4503L5.13549 1.45016L5.32888 0.724774H20.8093Z" Stroke="#C60E0E" StrokeThickness="1.5" Fill="Transparent" Stretch="Fill"/>
                                                            <Path x:Name="RadioInner" Data="M15 0H3.5L0 13H11.5167L15 0Z" Fill="#C60E0E" Stretch="Fill" Margin="3,2.3" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RadioInner" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton x:Name="CustomLaunchRadio" Content="{lex:Loc Game.CustomPath}" Foreground="#EEEEEE" FontSize="16" VerticalAlignment="Center" Checked="LaunchModeRadio_Changed" Cursor="Hand">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                                        <Grid Width="22" Height="18" Margin="0,0,8,0">
                                                            <Path x:Name="RadioOuter" Data="M20.8093 0.724774L20.6165 1.44828L16.6167 16.4484L16.4233 17.1738H0.942858L1.13574 16.4503L5.13549 1.45016L5.32888 0.724774H20.8093Z" Stroke="#C60E0E" StrokeThickness="1.5" Fill="Transparent" Stretch="Fill"/>
                                                            <Path x:Name="RadioInner" Data="M15 0H3.5L0 13H11.5167L15 0Z" Fill="#C60E0E" Stretch="Fill" Margin="3,2.3" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RadioInner" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel x:Name="CustomPathPanel" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <svgc:SvgViewbox Source="/Assets/startuppath.svg" Width="17" Height="15" Margin="20,0,10,0" VerticalAlignment="Center"/>
                            <!-- <TextBlock x:Name="CustomPathText" Text="点击选择游戏路径..." FontSize="13" Foreground="#B3EEEEEE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextDecorations="Underline" Cursor="Hand" MouseLeftButtonDown="BrowseCustomPath_Click" MaxWidth="300"/> -->
                            <controls:SkipInkTextBlock x:Name="CustomPathText" Text="{lex:Loc Game.SelectGamePath}" FontSize="16" FontWeight="Regular" Foreground="#B3EEEEEE" UnderlineBrush="#B3EEEEEE" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonDown="BrowseCustomPath_Click" MaxWidth="250"/>
                        </StackPanel>
                    </Grid>

                    <!-- 遥测配置按钮：内容决定宽度，后台 Path 由 code-behind 更新 -->
                    <Grid x:Name="TelemetryConfigButton" Grid.Row="4" Margin="0,20,0,0" Cursor="Hand"
                          MouseLeftButtonDown="TelemetryConfigButton_Click" Height="27" HorizontalAlignment="Left"
                          Visibility="Collapsed">
                        <Grid.Resources>
                            <LinearGradientBrush x:Key="TelemetryButtonGradient" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#C60E0E" Offset="0"/>
                                <GradientStop Color="#600707" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Resources>

                        <!-- Canvas 子元素不参与 Grid 布局测量，仅内容层决定宽度 -->
                        <Canvas>
                            <Path x:Name="TelemetryButtonBackground" Height="27"
                                  Fill="{StaticResource TelemetryButtonGradient}"/>
                        </Canvas>

                        <DockPanel x:Name="TelemetryButtonContent" VerticalAlignment="Center"
                                   SizeChanged="TelemetryButtonContent_SizeChanged">
                            <Path DockPanel.Dock="Right"
                                  Data="M15.75,5.72996C15.75,8.10163 13.8274,10.0243 11.4557,10.0243C10.7304,10.0243 10.0471,9.84444 9.44797,9.52698L3.22495,15.75L0.75,13.2751L6.97302,7.05203C6.65556,6.45287 6.47574,5.76958 6.47574,5.0443C6.47574,2.67262 8.39837,0.75 10.77,0.75C11.4953,0.75 12.1786,0.929806 12.7778,1.24728L10.0543,3.97073L12.5293,6.44568L15.2527,3.72223C15.5702,4.32139 15.75,5.00469 15.75,5.72996Z"
                                  Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform"
                                  Width="15" Height="15" Margin="10,0,15,0"/>
                            <TextBlock Text="{lex:Loc Game.TelemetryConfig}" FontSize="16" FontWeight="Bold"
                                       Foreground="#EEEEEE" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" Width="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TabControl x:Name="ConfigTabControl" Grid.Row="0" Grid.RowSpan="2" Background="Transparent" BorderThickness="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TabPanel Grid.Row="0" IsItemsHost="True" HorizontalAlignment="Right" Background="Transparent"/>

                                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid x:Name="TabItemGrid" Margin="30,0,0,0" >
                                                <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0" MinWidth="133" Height="39" Padding="20,0" HorizontalAlignment="Center">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="0" TextBlock.FontSize="22" TextBlock.FontWeight="Medium" TextBlock.Foreground="#EEEEEE" TextBlock.FontStyle="Italic"/>
                                                </Border>
                                                <Border x:Name="UnderlineGrid" Visibility="Collapsed"
                                                        Height="4" Background="#CCC60E0E" Opacity="0.8"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Width="{Binding ElementName=TabBorder, Path=ActualWidth}">
                                                    <Border.RenderTransform>
                                                        <SkewTransform AngleX="-30"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                                    <Setter TargetName="UnderlineGrid" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Foreground" Value="#8892A0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>


                        <TabItem Header="{lex:Loc Game.DeviceConfig}">
                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{lex:Loc Game.AutoApplyPreset}" FontSize="16" FontWeight="Regular" Foreground="#EEEEEE" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <CheckBox x:Name="AutoApplyPresetCheckBox" IsChecked="True" Style="{StaticResource DualStateSvgToggleStyle}" Checked="AutoApplyPreset_Changed" Unchecked="AutoApplyPreset_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,0">
                                    <Grid.Resources>
                                        <Style x:Key="TechPresetComboBoxStyle" TargetType="ComboBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#EEEEEE"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="15,0,30,0"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <!--<Setter Property="Cursor" Value="Hand"/>-->
                                            <Setter Property="Width" Value="232"/>
                                            <Setter Property="Height" Value="26"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <ControlTemplate.Resources>
                                                            <Style TargetType="ScrollBar">
                                                                <Setter Property="Background" Value="#D9D9D9"/>
                                                                <Setter Property="Width" Value="3"/>
                                                                <Setter Property="Margin" Value="0,4,4,4"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ScrollBar">
                                                                            <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" CornerRadius="1.5">
                                                                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                                                    <Track.Thumb>
                                                                                        <Thumb>
                                                                                            <Thumb.Template>
                                                                                                <ControlTemplate TargetType="Thumb">
                                                                                                    <Border Background="#C60E0E" CornerRadius="1.5" Margin="0"/>
                                                                                                </ControlTemplate>
                                                                                            </Thumb.Template>
                                                                                        </Thumb>
                                                                                    </Track.Thumb>
                                                                                </Track>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ControlTemplate.Resources>
                                                        <Grid>
                                                            <Path Data="M5 11V31H231L237 25V5H11L5 11Z" Fill="#EEEEEE" Opacity="0.2" Stretch="Fill">
                                                                <Path.Effect>
                                                                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5" ShadowDepth="2"/>
                                                                </Path.Effect>
                                                            </Path>

                                                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Grid Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>

                                                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>

                                                            <svgc:SvgViewbox Source="/Assets/edit.svg" Stretch="Fill" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,32,0"/>

                                                            <Path x:Name="Arrow" Data="M13.0605 1.06055L7.06055 7.06055L1.06055 1.06055" Stroke="#EEEEEE" StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="0"/>
                                                                </Path.RenderTransform>
                                                            </Path>

                                                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" VerticalOffset="-5" PopupAnimation="Fade">
                                                                <Grid Width="{TemplateBinding ActualWidth}">

                                                                    <Rectangle>
                                                                        <Rectangle.Fill>
                                                                            <DrawingBrush Stretch="Fill">
                                                                                <DrawingBrush.Drawing>
                                                                                    <DrawingGroup>
                                                                                        <GeometryDrawing Brush="#474747" Geometry="M5 27.9962V149H231L237 143V5L231.432 11H5V27.9962Z" />
                                                                                        <GeometryDrawing Geometry="M237,5 L231.432,11 H5">
                                                                                            <GeometryDrawing.Pen>
                                                                                                <Pen Brush="#EEEEEE" Thickness="1.5" />
                                                                                            </GeometryDrawing.Pen>
                                                                                        </GeometryDrawing>
                                                                                    </DrawingGroup>
                                                                                </DrawingBrush.Drawing>
                                                                            </DrawingBrush>
                                                                        </Rectangle.Fill>
                                                                        <Rectangle.Effect>
                                                                            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5" ShadowDepth="0"/>
                                                                        </Rectangle.Effect>
                                                                    </Rectangle>

                                                                    <ScrollViewer MaxHeight="120" 
                                                                                  VerticalScrollBarVisibility="Auto" 
                                                                                  HorizontalScrollBarVisibility="Disabled" 
                                                                                  Margin="0,15,0,5"
                                                                                  HorizontalAlignment="Left">
                                                                        <ItemsPresenter/>
                                                                    </ScrollViewer>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
