                                                        <PathGeometry Figures="M11.1346 12.2885V14.5962C11.1346 14.9022 11.013 15.1957 10.7967 15.412C10.5803 15.6284 10.2868 15.75 9.98077 15.75H1.90385C1.59783 15.75 1.30434 15.6284 1.08795 15.412C0.871566 15.1957 0.75 14.9022 0.75 14.5962V1.90385C0.75 1.59783 0.871566 1.30434 1.08795 1.08795C1.30434 0.871566 1.59783 0.75 1.90385 0.75H9.98077C10.2868 0.75 10.5803 0.871566 10.7967 1.08795C11.013 1.30434 11.1346 1.59783 11.1346 1.90385V4.21154"/>
                                                        <PathGeometry Figures="M14.75 8.25H6.67308"/>
                                                        <PathGeometry Figures="M8.98242 5.94238L6.67473 8.25008L8.98242 10.5578"/>
                                                    </GeometryGroup>
                                                </Path.Data>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{lex:Loc Settings.LoginAccountLabel}"
                                               Foreground="#EEEEEE"
                                               FontSize="16"
                                               FontWeight="Regular"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 登录/注册提示文本边框 -->
                                <Grid Width="600" Height="98" Margin="0,0,0,10">
                                    <Path Data="M5 16.4737V103H593L605 91.5263V5H17L5 16.4737Z"
                                          Stretch="Fill"
                                          Fill="#33EEEEEE"/>
                                    <StackPanel VerticalAlignment="Center" Margin="21,0,0,0">
                                        <TextBlock Text="{lex:Loc Settings.LoginRegisterPrompt}"
                                                   Foreground="#EEEEEE"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{lex:Loc Settings.LoginSyncPrompt}"
                                                   Foreground="#99EEEEEE"
                                                   FontSize="16"
                                                   FontWeight="Regular"
                                                   MaxWidth="560"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 立即登录按钮 -->
                                <Button Width="140" Height="27"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        Click="LoginNowButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="140" Height="27">
                                                <Path Data="M0 5.78571V27H134L140 21.2143V0H6L0 5.78571Z"
                                                      Stretch="Fill"
                                                      Fill="{StaticResource TabSelectedGradient}"
                                                      Stroke="Transparent"
                                                      StrokeThickness="0"/>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Viewbox Width="14" Height="14"
                                                             Margin="0,0,10,0">
                                                        <Canvas Width="16" Height="17">
                                                            <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                                <Path.Data>
                                                                    <GeometryGroup>
                                                                        <PathGeometry Figures="M7.88086 8.25C9.95193 8.25 11.6309 6.57107 11.6309 4.5C11.6309 2.42893 9.95193 0.75 7.88086 0.75C5.80979 0.75 4.13086 2.42893 4.13086 4.5C4.13086 6.57107 5.80979 8.25 7.88086 8.25Z"/>
                                                                        <PathGeometry Figures="M15.0115 15.7505C14.5271 14.24 13.5755 12.9223 12.294 11.9874C11.0124 11.0526 9.46708 10.5488 7.88077 10.5488C6.29446 10.5488 4.74912 11.0526 3.46756 11.9874C2.18599 12.9223 1.23441 14.24 0.75 15.7505H15.0115Z"/>
                                                                    </GeometryGroup>
                                                                </Path.Data>
                                                            </Path>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{lex:Loc Settings.LoginNow}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="16"
                                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- 已登录状态 -->
                            <StackPanel x:Name="LoggedInAccountPanel" Visibility="Collapsed">
                                <!-- 退出登录图标+文字 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Viewbox Width="17" Height="17"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center">
                                        <Canvas Width="17" Height="17">
                                            <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                <Path.Data>
                                                    <GeometryGroup>
                                                        <PathGeometry Figures="M11.1346 12.2885V14.5962C11.1346 14.9022 11.013 15.1957 10.7967 15.412C10.5803 15.6284 10.2868 15.75 9.98077 15.75H1.90385C1.59783 15.75 1.30434 15.6284 1.08795 15.412C0.871566 15.1957 0.75 14.9022 0.75 14.5962V1.90385C0.75 1.59783 0.871566 1.30434 1.08795 1.08795C1.30434 0.871566 1.59783 0.75 1.90385 0.75H9.98077C10.2868 0.75 10.5803 0.871566 10.7967 1.08795C11.013 1.30434 11.1346 1.59783 11.1346 1.90385V4.21154"/>
                                                        <PathGeometry Figures="M7.67383 8.25H15.7508"/>
                                                        <PathGeometry Figures="M13.4414 5.94238L15.7491 8.25008L13.4414 10.5578"/>
                                                    </GeometryGroup>
                                                </Path.Data>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{lex:Loc Settings.Logout}"
                                               Foreground="#EEEEEE"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 退出确认文本边框 -->
                                <Grid Width="600" Height="98" Margin="0,0,0,10">
                                    <Path Data="M5 16.4737V103H593L605 91.5263V5H17L5 16.4737Z"
                                          Stretch="Fill"
                                          Fill="#33EEEEEE"/>
                                    <StackPanel VerticalAlignment="Center" Margin="21,0,21,0">
                                        <TextBlock Text="{lex:Loc Settings.LogoutConfirmPrompt}"
                                                   Foreground="#EEEEEE"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{lex:Loc Settings.LogoutConfirmHint}"
                                                   Foreground="#99EEEEEE"
                                                   FontSize="16"
                                                   FontWeight="Regular"
                                                   MaxWidth="559"
                                                   TextWrapping="WrapWithOverflow"
                                                   Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 确认退出 / 取消 按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="ConfirmLogoutBtn" Height="27" Cursor="Hand" Margin="0,0,100,0"
                                            Click="ConfirmLogout_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Height="27" MinWidth="122"
                                                      SizeChanged="ConfirmButtonBg_SizeChanged">
                                                    <Path Stretch="Fill"
                                                          Fill="{StaticResource TabSelectedGradient}"/>
                                                    <TextBlock Text="{lex:Loc Settings.ConfirmLogout}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="CancelLogoutBtn" Height="27" Cursor="Hand"
                                            Click="CancelChange_Click" Tag="Logout">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Height="27" MinWidth="122"
                                                      SizeChanged="ConfirmButtonBg_SizeChanged">
                                                    <Path Stretch="Fill"
                                                          Fill="#CC3B3B3B"/>
                                                    <TextBlock Text="{lex:Loc Settings.CancelChange}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
