<UserControl x:Class="HITAPEX.Views.SettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
             xmlns:controls="clr-namespace:HITAPEX.Controls"
             xmlns:lex="clr-namespace:HITAPEX.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="924" d:DesignWidth="1342"
             Background="Transparent"
             Focusable="True"
             Loaded="SettingsUserControl_Loaded">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="TabSelectedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C60E0E" Offset="0"/>
            <GradientStop Color="#600707" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SettingsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Width" Value="266"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="266" Height="45">
                            <Path x:Name="ButtonPath"
                          Data="M15.9058 1.5H256.7C257.984 1.5 259.165 2.20315 259.777 3.33203L263.752 10.666C264.245 11.5751 264.31 12.6562 263.931 13.6182L253.025 41.2832C252.498 42.6205 251.207 43.4999 249.769 43.5H8.9751C7.69107 43.4999 6.50985 42.7968 5.89795 41.668L1.92236 34.334C1.42962 33.4249 1.36443 32.3438 1.74365 31.3818L12.6499 3.7168C13.1771 2.37956 14.4684 1.50019 15.9058 1.5Z"
                          Stretch="Fill"
                          Fill="Transparent"
                          Stroke="{StaticResource TabSelectedGradient}"
                          StrokeThickness="3"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="#FFFFFF"
                                      TextElement.FontWeight="Medium"
                                      TextElement.FontSize="22"
                                      TextElement.FontStyle="Italic"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill" Value="{StaticResource TabSelectedGradient}"/>
                                <Setter TargetName="ContentPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabButtonStyle2" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Width" Value="264"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="264" Height="45">
                            <Path x:Name="ButtonPath"
                          Data="M12.5693 1.5H254.862C256.146 1.5001 257.328 2.20313 257.939 3.33203L261.914 10.666C262.407 11.575 262.472 12.6553 262.093 13.6172L251.188 41.2832C250.66 42.6205 249.369 43.4998 247.932 43.5H5.00488C2.53554 43.4999 0.843171 41.0117 1.75 38.7148L11.2217 14.7236C11.9285 12.9335 11.8061 10.9222 10.8867 9.23145L9.49512 6.67188C8.22694 4.33976 9.91476 1.5002 12.5693 1.5Z"
                          Stretch="Fill"
                          Fill="Transparent"
                          Stroke="{StaticResource TabSelectedGradient}"
                          StrokeThickness="3"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="#FFFFFF"
                                      TextElement.FontWeight="Medium"
                                      TextElement.FontSize="22"
                                      TextElement.FontStyle="Italic"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill" Value="{StaticResource TabSelectedGradient}"/>
                                <Setter TargetName="ContentPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="TitleIconShadow" 
                          ShadowDepth="0" 
                          BlurRadius="5" 
                          Opacity="0.4" 
                          Color="#C60E0E"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleContainerStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>

        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="22" Height="18" Margin="0,0,8,0">
                                <Path x:Name="RadioOuter" Data="M20.8093 0.724774L20.6165 1.44828L16.6167 16.4484L16.4233 17.1738H0.942858L1.13574 16.4503L5.13549 1.45016L5.32888 0.724774H20.8093Z" Stroke="#C60E0E" StrokeThickness="1.5" Fill="Transparent" Stretch="Fill"/>
                                <Path x:Name="RadioInner" Data="M15 0H3.5L0 13H11.5167L15 0Z" Fill="#C60E0E" Stretch="Fill" Margin="3,2.3" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioInner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="22" Height="18" Margin="0,0,8,0">
                                <Path x:Name="CheckBoxOuter" Data="M20.8093 0.724774L20.6165 1.44828L16.6167 16.4484L16.4233 17.1738H0.942858L1.13574 16.4503L5.13549 1.45016L5.32888 0.724774H20.8093Z" Stroke="#C60E0E" StrokeThickness="1.5" Fill="Transparent" Stretch="Fill"/>
                                <Path x:Name="CheckBoxInner" Data="M15 0H3.5L0 13H11.5167L15 0Z" Fill="#C60E0E" Stretch="Fill" Margin="3,2.3" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxInner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!--<Setter Property="Cursor" Value="Hand"/>-->
            <Setter Property="Width" Value="450"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Path Data="M455 5H11L5 11V43H6.8H449L455 37V5Z" Fill="#EEEEEE" Opacity="0.2" Stretch="Fill"/>

                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>

                            <Path x:Name="Arrow" Data="M13.0605 1.06055L7.06055 7.06055L1.06055 1.06055" Stroke="#EEEEEE" StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Width="15" Height="8">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" VerticalOffset="-5" PopupAnimation="Fade">
                                <Grid Width="{TemplateBinding ActualWidth}">

                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <DrawingBrush Stretch="Fill">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#474747" Geometry="M5 11L449 11L455 5V96.9669L449 103H5L5.06055 87.0968L5 11Z" />
                                                        <GeometryDrawing Geometry="M5 11 L449 11 L455 5">
                                                            <GeometryDrawing.Pen>
                                                                <Pen Brush="#EEEEEE" Thickness="1.5" />
                                                            </GeometryDrawing.Pen>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5" ShadowDepth="0"/>
                                        </Rectangle.Effect>
                                    </Rectangle>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,15,0,5" HorizontalAlignment="Left">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="434"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Path x:Name="CheckMark" Grid.Column="0" Data="M9.75 0.75L4.35262 8.75L0.75 5.75364" Stroke="#EEEEEE" StrokeThickness="1.5" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden"/>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C60E0E" Offset="0"/>
                                            <GradientStop Color="#600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C60E0E" Offset="0"/>
                                            <GradientStop Color="#600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#C60E0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A50C0C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8A0A0A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="UpdateButtonGrid" MinWidth="122" Height="27"
                              HorizontalAlignment="Left"
                              SizeChanged="UpdateButtonGrid_SizeChanged">
                            <Canvas>
                                <Path x:Name="ButtonBackground" Height="27"
                                      Fill="#EEEEEE" Opacity="0.3"/>
                                <Path x:Name="ProgressBackground" Height="27">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C60E0E" Offset="0"/>
                                            <GradientStop Color="#600707" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Canvas>
                            <TextBlock x:Name="ButtonText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="#FFFFFF"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="FirmwareListItemStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Rectangle Stroke="#33EEEEEE" StrokeThickness="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1.8,0.5">
                                        <GradientStop Color="#33607079" Offset="0"/>
                                        <GradientStop Color="#333F4A50" Offset="0.44"/>
                                        <GradientStop Color="#33282D30" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Rectangle Fill="Transparent" Stroke="#CC232323" StrokeThickness="15">
                                <Rectangle.Effect>
                                    <BlurEffect Radius="45" RenderingBias="Performance"/>
                                </Rectangle.Effect>
                            </Rectangle>

                            <ContentPresenter/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
            <svgc:SvgViewbox Source="/Assets/Group126547702.svg" Width="27.63" Height="18" Margin="0,0,8.24,3" VerticalAlignment="Bottom"/>
            <Grid>
                <TextBlock Text="{lex:Loc Settings.Title}" FontSize="26" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#99383838" Margin="0"/>

        <Grid Grid.Row="2" HorizontalAlignment="Left" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="SystemSettingsTab"
                             Content="{lex:Loc Settings.SystemSettings}"
                             Style="{StaticResource SettingsTabButtonStyle}"
                             GroupName="SettingsTabs"
                             IsChecked="True"
                             Checked="Tab_Checked"
                             Tag="SystemSettings"
                             Margin="0,0,-5,0"/>
                <RadioButton x:Name="FirmwareUpdateTab"
                             Content="{lex:Loc Settings.FirmwareUpdate}"
                             Style="{StaticResource SettingsTabButtonStyle2}"
                             GroupName="SettingsTabs"
                             Checked="Tab_Checked"
                             Tag="FirmwareUpdate"
                             Margin="0,0,-8,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,20,0,0">
            <Grid x:Name="ContentContainer" Margin="0">
                <Grid x:Name="SystemSettingsContent" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <Border>
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionTitleContainerStyle}" Margin="0,0,0,16">
                                    <Grid Width="8" Height="26" Effect="{StaticResource TitleIconShadow}">
                                        <Path Data="M0 2L2 0H4L0 4V2Z M8 0H6L0 6V26H5L8 23V0Z" Fill="{StaticResource TabSelectedGradient}"/>
                                    </Grid>
                                    <TextBlock Text="{lex:Loc Settings.SoftwareSettings}" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartCheckBox"
                                          Content="{lex:Loc Settings.AutoStart}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="AutoStartCheckBox_Changed"
                                          Unchecked="AutoStartCheckBox_Changed"
                                          AutomationProperties.Name="{lex:Loc Settings.AutoStart}"/>
                                <CheckBox x:Name="StartMinimizedCheckBox"
                                          Content="{lex:Loc Settings.StartMinimizedToTray}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="StartMinimizedCheckBox_Changed"
                                          Unchecked="StartMinimizedCheckBox_Changed"
                                          AutomationProperties.Name="{lex:Loc Settings.StartMinimizedToTray}"/>
                                <CheckBox x:Name="CloseMinimizedCheckBox"
                                          Content="{lex:Loc Settings.CloseMinimizedToTray}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="CloseMinimizedCheckBox_Changed"
                                          Unchecked="CloseMinimizedCheckBox_Changed"
                                          AutomationProperties.Name="{lex:Loc Settings.CloseMinimizedToTray}"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionTitleContainerStyle}">
                                    <Grid Width="8" Height="26" Effect="{StaticResource TitleIconShadow}">
                                        <Path Data="M0 2L2 0H4L0 4V2Z M8 0H6L0 6V26H5L8 23V0Z" Fill="{StaticResource TabSelectedGradient}"/>
                                    </Grid>
                                    <TextBlock Text="{lex:Loc Settings.LanguageSettings}" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Width="450"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="LanguageComboBox_SelectionChanged"
                                          AutomationProperties.Name="{lex:Loc Settings.SelectLanguage}">
                                    <ComboBoxItem Content="{lex:Loc Settings.Chinese}" Style="{StaticResource ComboBoxItemStyle}" Tag="zh-CN"/>
                                    <ComboBoxItem Content="English" Style="{StaticResource ComboBoxItemStyle}" Tag="en-US"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionTitleContainerStyle}">
                                    <Grid Width="8" Height="26" Effect="{StaticResource TitleIconShadow}">
                                        <Path Data="M0 2L2 0H4L0 4V2Z M8 0H6L0 6V26H5L8 23V0Z" Fill="{StaticResource TabSelectedGradient}"/>
                                    </Grid>
                                    <TextBlock Text="{lex:Loc Settings.ThemeSettings}" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Width="450"
                                          HorizontalAlignment="Left"
                                          SelectedIndex="0"
                                          AutomationProperties.Name="{lex:Loc Settings.SelectTheme}">
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Tag="Dark">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="18" Height="18">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#C60E0E" Offset="0"/>
                                                        <GradientStop Color="#1E1A1A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{lex:Loc Settings.DarkRed}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Width="620" HorizontalAlignment="Left" Margin="0,0,0,10">
