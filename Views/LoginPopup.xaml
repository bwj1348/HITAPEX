<UserControl x:Class="HITAPEX.Views.LoginPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:lex="clr-namespace:HITAPEX.Helpers"
             x:Name="LoginPopupRoot"
             Visibility="Visible">

    <!-- 半透明遮罩层 -->
    <Grid>
        <!-- 遮罩 -->
        <Grid Background="#991B1B1B"
              MouseDown="Overlay_MouseDown"/>

        <!-- 弹窗主体 -->
        <Grid Width="548" Height="789"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <!-- 背景形状 -->
            <Path Data="M548 0H15L0 15L0.267949 789H533.268L548.268 774L548 0Z"
                  Fill="#4A4A4A"
                  Stretch="Fill"/>

            <!-- 背景装饰 SVG -->
            <svgc:SvgViewbox Source="/Assets/Group1265485084.svg"
                             Stretch="Fill"/>

            <!-- 装饰线 -->
            <Path Data="M507.514 0.5L507.5 736.792L495.793 748.5H0.5L0.512695 12.207L12.2207 0.5H507.514Z"
                  Stroke="#EEEEEE"
                  StrokeThickness="1"
                  Stretch="Fill"
                  Width="509" Height="749"/>

            <!-- 关闭按钮 -->
            <Button Width="11" Height="11"
                    Cursor="Hand"
                    Margin="0,41,41,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Canvas Width="11" Height="11" Background="Transparent">
                            <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0,0 L11,11 M11,0 L0,11"/>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 内容区域 -->
            <Grid Margin="41">
                <!-- 第一行：HiTAPEX 标题 -->
                <svgc:SvgViewbox Source="/Assets/Group126549369.svg"
                                 Width="314" Height="40"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,0,0,20"/>

                <!-- ═══ 登录表单 ═══ -->
                <Grid x:Name="LoginFormPanel" Margin="0,60,0,0" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                        <!-- 第二行 -->
                        <TextBlock Foreground="#EEEEEE" FontSize="22"
                                   HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Run Text="{lex:Loc Login.LoginYourAccountPart1}"/><Run Text="HITAPEX" FontFamily="{StaticResource OrbitronFont}"/><Run Text="{lex:Loc Login.LoginYourAccountPart2}"/>
                        </TextBlock>

                        <!-- 邮箱 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.EmailLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid Height="38"
                                      SizeChanged="InputBorder_SizeChanged">
                                    <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                    <TextBox x:Name="LoginEmailTextBox"
                                         Text="{lex:Loc Login.EmailPlaceholder}"
                                         Foreground="#99EEEEEE" FontSize="16"
                                         CaretBrush="#EEEEEE" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Margin="15,0,40,0"
                                         GotFocus="LoginEmailTextBox_GotFocus"
                                         LostFocus="LoginEmailTextBox_LostFocus"/>
                                <Button Width="17" Height="17"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                        Cursor="Hand" Click="ClearLoginInput_Click" Tag="LoginEmailTextBox">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Canvas Width="17" Height="17" Background="Transparent">
                                                <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                    <Path.Data>
                                                        <GeometryGroup>
                                                            <PathGeometry Figures="M10.695 5.80371L5.80273 10.696"/>
                                                            <PathGeometry Figures="M5.80273 5.80371L10.695 10.696"/>
                                                            <PathGeometry Figures="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"/>
                                                        </GeometryGroup>
                                                    </Path.Data>
                                                </Path>
                                            </Canvas>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 密码 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.PasswordLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid Height="38"
                                      SizeChanged="InputBorder_SizeChanged">
                                    <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="LoginPasswordBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#99EEEEEE" CaretBrush="#EEEEEE" FontSize="16"
                                                 VerticalAlignment="Center" Margin="15,0,0,0"
                                                 PasswordChanged="LoginPasswordBox_PasswordChanged"
                                                 GotFocus="LoginPasswordBox_GotFocus"
                                                 LostFocus="LoginPasswordBox_LostFocus"/>
                                        <TextBlock x:Name="LoginPasswordPlaceholder" Grid.Column="0"
                                               Text="{lex:Loc Login.PasswordPlaceholder}"
                                               Foreground="#99EEEEEE" FontSize="16"
                                               VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                                        <Button x:Name="LoginPasswordEyeBtn" Grid.Column="1"
                                            Width="20" Height="17" VerticalAlignment="Center" Margin="10,0,8,0"
                                            Cursor="Hand" Click="ToggleLoginPasswordVisibility_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="20" Height="17" Background="Transparent">
                                                        <Path x:Name="EyeClosed" Stretch="Uniform"
                                                          Stroke="#EEEEEE" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                            <Path.Data>
                                                                <GeometryGroup>
                                                                    <PathGeometry Figures="M16.8108 6.06787C17.329 6.53151 17.7654 6.98151 18.0927 7.33605C18.3188 7.58662 18.444 7.91216 18.444 8.24969C18.444 8.58722 18.3188 8.91276 18.0927 9.16333C16.6608 10.7042 13.4018 13.7042 9.59721 13.7042H9.05176"/>
                                                                    <PathGeometry Figures="M5.3286 12.5181C3.74901 11.6335 2.32175 10.5009 1.10133 9.16359C0.87518 8.91302 0.75 8.58749 0.75 8.24996C0.75 7.91243 0.87518 7.58689 1.10133 7.33632C2.53314 5.79541 5.79224 2.79541 9.59678 2.79541C11.0965 2.82675 12.5642 3.23472 13.865 3.98177"/>
                                                                    <PathGeometry Figures="M17.0967 0.75L2.09668 15.75"/>
                                                                    <PathGeometry Figures="M7.67369 10.1729C7.16152 9.66383 6.87219 8.97237 6.86914 8.25022C6.86914 7.5269 7.15648 6.83321 7.66794 6.32175C8.1794 5.81029 8.8731 5.52295 9.59641 5.52295C10.3186 5.52599 11.01 5.81533 11.5191 6.32749"/>
                                                                    <PathGeometry Figures="M11.9691 9.61377C11.7263 10.0287 11.3782 10.3721 10.96 10.6092"/>
                                                                </GeometryGroup>
                                                            </Path.Data>
                                                        </Path>
                                                        <Path x:Name="EyeOpen" Stretch="Uniform"
                                                          Stroke="#EEEEEE" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Visibility="Collapsed">
                                                            <Path.Data>
                                                                <GeometryGroup>
                                                                    <PathGeometry Figures="M17.4124 5.11291C17.6297 5.35366 17.75 5.66644 17.75 5.99074C17.75 6.31504 17.6297 6.62781 17.4124 6.86856C16.0368 8.34907 12.9054 11.2315 9.25 11.2315C5.59459 11.2315 2.46325 8.34907 1.08755 6.86856C0.870273 6.62781 0.75 6.31504 0.75 5.99074C0.75 5.66644 0.870273 5.35366 1.08755 5.11291C2.46325 3.6324 5.59459 0.75 9.25 0.75C12.9054 0.75 16.0368 3.6324 17.4124 5.11291Z"/>
                                                                    <PathGeometry Figures="M9.25025 8.61134C10.6974 8.61134 11.8706 7.43816 11.8706 5.99097C11.8706 4.54378 10.6974 3.37061 9.25025 3.37061C7.80306 3.37061 6.62988 4.54378 6.62988 5.99097C6.62988 7.43816 7.80306 8.61134 9.25025 8.61134Z"/>
                                                                </GeometryGroup>
                                                            </Path.Data>
                                                        </Path>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2"
                                            Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,14,0"
                                            Cursor="Hand" Click="ClearLoginPassword_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Canvas Width="17" Height="17" Background="Transparent">
                                                        <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                            <Path.Data>
                                                                <GeometryGroup>
                                                                    <PathGeometry Figures="M10.6946 5.80371L5.80225 10.696"/>
                                                                    <PathGeometry Figures="M5.80225 5.80371L10.6946 10.696"/>
                                                                    <PathGeometry Figures="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"/>
                                                                </GeometryGroup>
                                                            </Path.Data>
                                                        </Path>
                                                    </Canvas>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 用户协议 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <CheckBox x:Name="AgreementCheckBox"
                                      Style="{DynamicResource CheckBoxStyle}"
                                      Margin="0,3,0,0" VerticalAlignment="Top"/>
                            <TextBlock VerticalAlignment="Center" FontSize="16" MaxWidth="430" TextWrapping="Wrap">
                                <Run Text="{lex:Loc Login.AgreementText1}" Foreground="#FFFFFF"/><Run Text="{lex:Loc Login.AgreementTerms}" Foreground="#C60E0E" Cursor="Hand" MouseDown="TermsLink_MouseDown"/><Run Text="{lex:Loc Login.AgreementAnd}" Foreground="#FFFFFF"/><Run Text="{lex:Loc Login.AgreementPrivacy}" Foreground="#C60E0E" Cursor="Hand" MouseDown="PrivacyLink_MouseDown"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- 登录按钮 -->
                        <Button Width="192" Height="27" Cursor="Hand"
                                HorizontalAlignment="Center" Margin="0,0,0,20"
                                Click="LoginButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="192" Height="27">
                                        <Path Data="M0 5.78571V27H186L192 21.2143V0H6L0 5.78571Z"
                                              Stretch="Fill" Fill="{StaticResource TabSelectedGradient}"/>
                                        <TextBlock Text="{lex:Loc Login.LoginButton}"
                                                   Foreground="#EEEEEE" FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 注册按钮 -->
                        <Button Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,30"
                                Click="SwitchToRegister_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{lex:Loc Login.RegisterLink}"
                                               Foreground="#EEEEEE" FontSize="16" FontWeight="Bold"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <!-- 忘记密码 -->
                            <Button Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,20"
                                    Click="SwitchToForgotPassword_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{lex:Loc Login.ForgotPassword}"
                                                       Foreground="#EEEEEE" FontSize="16" TextAlignment="Center">
                                                <TextBlock.TextDecorations>
                                                    <TextDecoration Location="Underline" PenOffset="3" PenOffsetUnit="Pixel"/>
                                                </TextBlock.TextDecorations>
                                            </TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                            </Button>
                            
                            <!-- 第三方登录分隔线 -->
                            <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Height="2" Stretch="Uniform"
                                     HorizontalAlignment="Right">
                                <Canvas Width="173" Height="2">
                                    <Path Data="M167 0L165 2H0L1.93 0H167Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M172 0H173L171 2H170Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M170 0H171L169 2H168Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M168 0H169L167 2H166Z" Fill="#EEEEEE" Opacity="0.3"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="{lex:Loc Login.ThirdPartyLogin}"
                                       Foreground="#EEEEEE" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,20,0"/>
                            <Viewbox Grid.Column="2" Height="2" Stretch="Uniform"
                                     HorizontalAlignment="Left">
                                <Canvas Width="173" Height="2">
                                    <Path Data="M6 2L8 0H173L171.07 2H6Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M1 2H0L2 0H3Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M3 2H2L4 0H5Z" Fill="#EEEEEE" Opacity="0.3"/>
                                    <Path Data="M5 2H4L6 0H7Z" Fill="#EEEEEE" Opacity="0.3"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- 第三方登录图标 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Width="50" Height="50" Cursor="Hand" Margin="0,0,20,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="50" Height="50">
                                            <Ellipse Width="50" Height="50" Fill="#D9D9D9"/>
                                            <TextBlock Text="WX" Foreground="#000000" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="50" Height="50" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="50" Height="50">
                                            <Ellipse Width="50" Height="50" Fill="#D9D9D9"/>
                                            <TextBlock Text="QQ" Foreground="#000000" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ 注册表单 ═══ -->
                    <Grid x:Name="RegisterFormPanel" Margin="0,60,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                        <!-- 第二行 -->
                        <TextBlock Foreground="#EEEEEE" FontSize="22"
                                   HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Run Text="{lex:Loc Login.RegisterYourAccountPart1}"/><Run Text="HITAPEX" FontFamily="{StaticResource OrbitronFont}"/><Run Text="{lex:Loc Login.RegisterYourAccountPart2}"/>
                        </TextBlock>

                        <!-- 邮箱 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.EmailLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid Height="38"
                                      SizeChanged="InputBorder_SizeChanged">
                                    <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                    <TextBox x:Name="RegisterEmailTextBox"
                                         Text="{lex:Loc Login.EmailPlaceholder}"
                                         Foreground="#99EEEEEE" FontSize="16"
                                         CaretBrush="#EEEEEE" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Margin="15,0,40,0"
                                         GotFocus="RegisterInput_GotFocus"
                                         LostFocus="RegisterInput_LostFocus"/>
                                <Button Width="17" Height="17"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                        Cursor="Hand" Click="ClearRegisterInput_Click" Tag="RegisterEmailTextBox">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Canvas Width="17" Height="17" Background="Transparent">
                                                <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                    <Path.Data>
                                                        <GeometryGroup>
                                                            <PathGeometry Figures="M10.695 5.80371L5.80273 10.696"/>
                                                            <PathGeometry Figures="M5.80273 5.80371L10.695 10.696"/>
                                                            <PathGeometry Figures="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"/>
                                                        </GeometryGroup>
                                                    </Path.Data>
                                                </Path>
                                            </Canvas>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 用户名 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.UsernameLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid Height="38"
                                      SizeChanged="InputBorder_SizeChanged">
                                <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                <TextBox x:Name="RegisterUsernameTextBox"
                                         Text="{lex:Loc Login.UsernamePlaceholder}"
                                         Foreground="#99EEEEEE" FontSize="16"
                                         CaretBrush="#EEEEEE" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Margin="15,0,40,0"
                                         GotFocus="RegisterInput_GotFocus"
                                         LostFocus="RegisterInput_LostFocus"/>
                                <Button Width="17" Height="17"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                        Cursor="Hand" Click="ClearRegisterInput_Click" Tag="RegisterUsernameTextBox">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Canvas Width="17" Height="17" Background="Transparent">
                                                <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                    <Path.Data>
                                                        <GeometryGroup>
                                                            <PathGeometry Figures="M10.695 5.80371L5.80273 10.696"/>
                                                            <PathGeometry Figures="M5.80273 5.80371L10.695 10.696"/>
                                                            <PathGeometry Figures="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"/>
                                                        </GeometryGroup>
                                                    </Path.Data>
                                                </Path>
                                            </Canvas>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 验证码 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.VerificationCodeLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="38"
                                          SizeChanged="InputBorder_SizeChanged">
                                <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                <TextBox x:Name="RegisterVerificationCodeTextBox"
                                         Text="{lex:Loc Settings.VerificationCodePlaceholder}"
                                         Foreground="#99EEEEEE" FontSize="16"
                                         CaretBrush="#EEEEEE" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Margin="15,0,40,0"
                                         GotFocus="RegisterInput_GotFocus"
                                         LostFocus="RegisterInput_LostFocus"/>
                                <Button Width="17" Height="17"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                        Cursor="Hand" Click="ClearRegisterInput_Click" Tag="RegisterVerificationCodeTextBox">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Canvas Width="17" Height="17" Background="Transparent">
                                                <Path Stroke="#EEEEEE" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                    <Path.Data>
                                                        <GeometryGroup>
                                                            <PathGeometry Figures="M10.695 5.80371L5.80273 10.696"/>
                                                            <PathGeometry Figures="M5.80273 5.80371L10.695 10.696"/>
                                                            <PathGeometry Figures="M8.25 15.75C12.3921 15.75 15.75 12.3921 15.75 8.25C15.75 4.10786 12.3921 0.75 8.25 0.75C4.10786 0.75 0.75 4.10786 0.75 8.25C0.75 12.3921 4.10786 15.75 8.25 15.75Z"/>
                                                        </GeometryGroup>
                                                    </Path.Data>
                                                </Path>
                                            </Canvas>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                                    <Button Grid.Column="1" Width="110" Height="38" Cursor="Hand" Margin="10,0,0,0"
                                            Click="GetRegisterVerificationCode_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="110" Height="38">
                                            <Path Data="M115.001 5.08038L11 5.00018L5 11.0002V43.0002H6.8L109.001 43.0804L115.001 37.0804V5.08038Z"
                                                  Stretch="Fill" Fill="{StaticResource TabSelectedGradient}"/>
                                            <TextBlock Text="{lex:Loc Settings.GetVerificationCode}"
                                                       Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 密码 -->
                        <Border Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Login.PasswordLabel}"
                                           Foreground="#EEEEEE" FontSize="16"
                                           Margin="0,0,0,10"/>
                                <Grid Height="38"
                                      SizeChanged="InputBorder_SizeChanged">
                                    <Path Stretch="Fill" Fill="#33EEEEEE"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#99EEEEEE" CaretBrush="#EEEEEE" FontSize="16"
                                                 VerticalAlignment="Center" Margin="15,0,0,0"
                                                 PasswordChanged="RegisterPasswordBox_PasswordChanged"
                                                 GotFocus="RegisterPasswordBox_GotFocus"
                                                 LostFocus="RegisterPasswordBox_LostFocus"/>
                                    <TextBlock x:Name="RegisterPasswordPlaceholder" Grid.Column="0"
                                               Text="{lex:Loc Login.PasswordPlaceholder}"
                                               Foreground="#99EEEEEE" FontSize="16"
                                               VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                                    <Button x:Name="RegisterPasswordEyeBtn" Grid.Column="1"
